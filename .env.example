DATABASE_URL=postgresql://trientes:CHANGE_ME@127.0.0.1:5432/trientes
REDIS_URL=redis://127.0.0.1:6379
NEXTAUTH_URL=https://trientes.org
NEXTAUTH_SECRET=CHANGE_ME

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Admin bootstrap. Comma-separated entries with prefixes:
#   email:foo@bar.com
#   telegram:123456789
#   github:octocat
ADMIN_WHITELIST=

# Coin data sources (used in Phase 2)
COINGECKO_API_KEY=
BINANCE_USE_WS=true
PRICE_REFRESH_SEC=60

# Email via Mailcow (mail.selyanska.eu, shared with Selyanska) — optional. Without
# SMTP_USER/SMTP_PASS emails are silently skipped; Telegram and web-push still work.
SMTP_HOST=mail.selyanska.eu
SMTP_PORT=587
SMTP_USER=noreply@trientes.org
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@trientes.org
# Mailbox that gets a copy of every new listing request (/request).
LISTING_REQUESTS_TO=listing@trientes.org
