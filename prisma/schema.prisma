  @@index([source])
  @@index([supportedCardIds(ops: ArrayOps)], type: Gin)
  @@index([ownerUserId])
}

// Local mirror of BTC Map's crypto-POI dump (itself OpenStreetMap data), synced
// nightly by the worker. Reading the viewport from here instead of querying the
// public Overpass API live keeps the navigator working while those instances are
// saturated. `tags` holds the untouched OSM tag map, so the same
// parseOverpassElements() turns a row back into a Poi — including the per-coin
// `coinSpecific` flag, which can only be decided at read time.
model OsmCryptoPoi {
  id       String   @id // BTC Map id, e.g. "node:9778525869"
  type     String // node | way | relation
  osmId    String
  lat      Float
  lon      Float
  tags     Json
  syncedAt DateTime @default(now())

  @@index([lat, lon])
}

// ---------------------------------------------------------------------------
// Собственный листинг монет (слайс A). Карточка намеренно отвязана от
// Coin.id = CoinGecko id: у неё свой cuid и свой slug, поэтому проект можно
// залистинговать, когда его нет ни в одном внешнем фиде. Связь с Coin
// необязательная — для монет, которые у нас уже есть.
// Спека: docs/superpowers/specs/2026-11-06-coin-card-listing-design.md
// ---------------------------------------------------------------------------

model CoinCard {
  id            String        @id @default(cuid())
  slug          String        @unique
  coinId        String?       @unique
  coin          Coin?         @relation("CoinCardCoin", fields: [coinId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Первый подавший карточку. Владеет ею как куратор, пока проект не докажет
  // права (слайс D) — тогда вытесняется. Защита от сквоттинга листингов.
  stewardUserId String?
  steward       User?         @relation("CoinCardSteward", fields: [stewardUserId], references: [id], onDelete: SetNull)
  trust         CoinCardTrust @default(UNVERIFIED)
  status        RequestStatus @default(PENDING)
  completeness  Int           @default(0)
  name          String
  symbol        String
  tagline       String?
  description   String?       @db.Text
  logoUrl       String?
  launchDate    DateTime?
  tags          String[]      @default([])
  // Язык, на котором проект ввёл прозу. Пусто → определяется один раз
  // автоматически при первом публичном рендере и сохраняется.
  sourceLocale  String?
  consensus     String?
  hashAlgo      String?
  /// Ключ сети из substrate-chains, если монета — нативная единица собственной
  /// сети. Контракта у такой монеты нет: идентичность сети — хэш генезиса.
  nativeChain   String?
  links         Json?
  tokenomics    Json?
  teamInfo      Json?
  marketing     Json?
  security      Json?
  // Слайс F2 (платёжный профиль) и F4 (правовой статус) — поля создаются одной
  // миграцией со всем слайсом F, наполняются позже.
  payments      Json?
  legal         Json?
  // {"<путь поля>": {kind, source, at}} — откуда взято каждое значение.
  provenance    Json?
  rejectReason  String?
  reviewedById  String?
  reviewer      User?         @relation("CoinCardReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  contracts CoinCardContract[]
  markets   CoinCardMarket[]
  members   CoinCardMember[]
  invites   CoinCardInvite[]
  revisions CoinCardRevision[]
  policy    CoinCardPolicy?

  priceIndex  CoinCardPriceIndex?
  pricePoints CoinCardPricePoint[]
  claims      CoinCardClaim[]
  supply      CoinCardSupply?
  chainFacts  CoinCardChainFacts?
  watchedBy   CardWatchlist[]

  @@index([status, createdAt])
  @@index([trust])
}

// Адрес контракта в конкретной сети. Без него настоящий токен не отличить от
// подделки с тем же тикером — поэтому раздел высокорисковый.
model CoinCardContract {
  id          String    @id @default(cuid())
  cardId      String
  card        CoinCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  chain       String
  address     String
  decimals    Int?
  standard    String?
  isCanonical Boolean   @default(false)
  explorerUrl String?
  verifiedAt  DateTime? // ставится слайсом B, только когда факт сошёлся с заявлением

  // Слайс B: что ответил контракт. Заявление проекта остаётся как есть —
  // расхождение показывается рядом, а не затирает введённое.
  onchainName        String?
  onchainSymbol      String?
  onchainDecimals    Int?
  onchainTotalSupply String? // десятичная строка: uint256 не влезает в Int
  onchainFlags       String[]  @default([])
  mismatches         String[]  @default([])
  checkedAt          DateTime?
  checkError         String?

  @@unique([cardId, chain, address])
  @@index([chain, address])
  @@index([checkedAt])
}

// Где монета торгуется. claimedAt — заявлено проектом, confirmedAt — сверено
// нашим агрегатором (слайс C). priceUsd/volumeUsd24h в слайсе A всегда null.
model CoinCardMarket {
  id           String    @id @default(cuid())
  cardId       String
  card         CoinCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind         String // "CEX" | "DEX"
  exchangeId   String? // мягкая ссылка на Exchange.id, без FK
  exchangeName String
  pair         String
  tradeUrl     String?
  chain        String?
  poolAddress  String?
  priceUsd     Float?
  volumeUsd24h Float?
  claimedAt    DateTime  @default(now())
  confirmedAt  DateTime?
  // Слайс C: результат сверки с публичным API биржи.
  nativeSymbol String? // символ пары на бирже, как он найден в снимке тикеров
  quote        String? // нормализованная котировка: USDT, BTC, ...
  change24h    Float?
  isOutlier    Boolean   @default(false) // виден в таблице, но не в индексе
  checkedAt    DateTime?
  checkError   String?

  @@unique([cardId, kind, exchangeName, pair])
  @@index([cardId])
}

// Участник команды карточки. Образец — CompanyMember.
model CoinCardMember {
  id          String            @id @default(cuid())
  cardId      String
  card        CoinCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation("CoinCardMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role        CoinCardRole      @default(VIEWER)
  sections    CoinCardSection[] @default([]) // значимо только для EDITOR
  isSigner    Boolean           @default(false) // входит в группу мультиподписи
  invitedById String?
  createdAt   DateTime          @default(now())

  approvals CoinCardApproval[]

  @@unique([cardId, userId])
  @@index([userId])
}

// Одноразовая ссылка-приглашение для тех, у кого ещё нет аккаунта.
// Образец — CompanyInvite.
model CoinCardInvite {
  id           String            @id @default(cuid())
  cardId       String
  card         CoinCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  role         CoinCardRole      @default(VIEWER)
  sections     CoinCardSection[] @default([])
  isSigner     Boolean           @default(false)
  token        String            @unique
  createdById  String
  createdBy    User              @relation("CoinCardInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  acceptedById String?
  acceptedBy   User?             @relation("CoinCardInviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime          @default(now())

  @@index([cardId, createdAt])
}

// Политика мультиподписи. Пустой sections = применяется ко всем изменениям.
model CoinCardPolicy {
  cardId    String            @id
  card      CoinCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  multisig  Boolean           @default(false)
  threshold Int               @default(1) // M из N подписантов
  sections  CoinCardSection[] @default([])
  updatedAt DateTime          @updatedAt
}

// Слайс C. Наш собственный ценовой индекс карточки: медиана цены по весу
// суточного объёма подтверждённых рынков. Отдельная модель, а не поля в
// CoinCard, потому что это вычисленное значение со своей методикой — ревизии
// и диффы карточки (coin-card-diff.ts) его не касаются.
model CoinCardPriceIndex {
  id           String   @id @default(cuid())
  cardId       String   @unique
  card         CoinCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  priceUsd     Float
  change24h    Float?
  volumeUsd24h Float
  marketCount  Int
  spreadPct    Float?
  confidence   String // HIGH | MEDIUM | LOW
  method       String   @default("VWMEDIAN_V1")
  // Слайс E: цена, умноженная на выпуск. Считается здесь, а не в CoinCardSupply,
  // потому что меняется с ценой (каждые 10 минут), а не с выпуском (раз в час).
  marketCapUsd Float?
  fdvUsd       Float?
  supplySource String? // ONCHAIN | SELF_REPORTED — чем мерили выпуск
  computedAt   DateTime
}

// Часовая история индекса. График — не этот слайс, но историю нельзя добрать
// потом, поэтому точки копятся с первого прогона. Хранение — 90 дней.
model CoinCardPricePoint {
  id           String   @id @default(cuid())
  cardId       String
  card         CoinCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  priceUsd     Float
  volumeUsd24h Float
  marketCount  Int
  at           DateTime // округлено до часа

  @@unique([cardId, at])
  @@index([cardId, at])
}

// Слайс E: факт сети о выпуске — что ответили контракт и адреса исключений.
// Отдельная модель, а не поля в CoinCard: заявление проекта лежит в `tokenomics`
// и не должно затираться фактом (то же правило, что у контрактов в слайсе B).
model CoinCardSupply {
  id              String   @id @default(cuid())
  cardId          String   @unique
  card            CoinCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  chain           String
  address         String
  decimals        Int
  // Десятичные строки в монетах, не в минимальных единицах: uint256 в Float не влезает.
  totalSupply     String
  excludedTotal   String
  circulating     String
  // [{address, label, balance, error}] — из чего сложился excludedTotal.
  excluded        Json
  // Хотя бы один адрес не ответил: расчёт неполный, и в карточке об этом сказано.
  partial         Boolean  @default(false)
  // Отклонение заявленного проектом circulating от посчитанного, в процентах.
  claimedDeltaPct Float?
  method          String   @default("ONCHAIN_V1")
  checkedAt       DateTime
  checkError      String?

  @@index([checkedAt])
}

// Факты собственной сети нативной монеты (слайс S). Отдельно от
// CoinCardSupply: выпуск и скорость сети обновляются с разной частотой и
// читаются разными разделами карточки; одна строка заставляла бы переписывать
// выпуск при каждом замере времени блока.
model CoinCardChainFacts {
  id                String   @id @default(cuid())
  cardId            String   @unique
  card              CoinCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  chain             String
  /// SUBSTRATE | COSMOS — какой ридер отвечал. Рендер подписывает факты
  /// по-разному: у Cosmos финальность достигается в том же блоке, а комиссию
  /// перевода пока никто не считает.
  family            String   @default("SUBSTRATE")
  /// Необязателен с слайса V: у Cosmos идентичность сети — chain-id, а блок 1
  /// на обрезанных узлах недоступен.
  genesisHash       String?
  /// Идентичность сети Cosmos: "celestia", "dydx-mainnet-1".
  chainId           String?
  /// Минимальная цена газа, заявленная узлом ("0.002utia" → "0.002"). Строкой:
  /// это десятичная дробь, а не число с плавающей точкой.
  minGasPrice       String?
  tokenSymbol       String?
  tokenDecimals     Int?
  ss58Format        Int?
  // Измерено: (t(N) − t(N−k)) / k. Float, потому что это замер, а не константа.
  blockSeconds      Float?
  blockSample       Int?
  bestNumber        Int?
  finalizedNumber   Int?
  finalityLag       Int?
  // finalityLag × blockSeconds. Производное, но хранится: рендер не считает.
  finalitySeconds   Float?
  /// Слайс T: комиссия эталонного перевода (одна монета, keep-alive) в
  /// наименьших единицах. String, а не BigInt: приходит из RPC строкой и дальше
  /// только форматируется.
  transferFeePlanck String?
  /// Та же комиссия в монетах: planck / 10^tokenDecimals.
  transferFeeTokens Float?
  /// fee_unsupported | runtime_changed | rpc_unreachable | rpc_error | decode_failed
  transferFeeError  String?
  // SYMBOL | DECIMALS — расхождение сети с заявленным в карточке;
  // CHAIN_SYMBOL | SS58_FORMAT — расхождение сети с реестром;
  // FEE_USD — заявленная комиссия расходится с проверенной.
  mismatches        String[] @default([])
  checkedAt         DateTime
  // chain_unsupported | rpc_unreachable | rpc_error | decode_failed | genesis_mismatch
  checkError        String?

  @@index([checkedAt])
}

// Заявка на подтверждение владения карточкой. Отдельная модель, а не поля в
// CoinCard: заявок бывает несколько (разные способы, разные люди), а попытки с
// ошибками — это журнал, а не свойство монеты.
model CoinCardClaim {
  id          String      @id @default(cuid())
  cardId      String
  card        CoinCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  claimantId  String
  claimant    User        @relation("CoinCardClaimant", fields: [claimantId], references: [id], onDelete: Cascade)
  method      ClaimMethod
  status      ClaimStatus @default(PENDING)
  /// Токен вызова: ищется в DNS и в файле, входит в текст подписи.
  token       String      @unique
  /// Домен или адрес, который мы проверяли, — для публичной истории.
  target      String?
  attempts    Int         @default(0)
  lastError   String?
  lastTriedAt DateTime?
  verifiedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime    @default(now())

  @@index([cardId, status])
  @@index([claimantId, createdAt])
}

// Пакет изменений. thresholdAt/signerCountAt — снимок на момент подачи: без
// него смена состава подписантов на ходу меняет исход идущего голосования.
model CoinCardRevision {
  id            String                 @id @default(cuid())
  cardId        String
  card          CoinCard               @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind          CoinCardRevisionKind   @default(CONTENT)
  section       CoinCardSection? // null только при kind = POLICY
  authorId      String
  author        User                   @relation("CoinCardRevisionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  status        CoinCardRevisionStatus @default(DRAFT)
  highRisk      Boolean                @default(false)
  diff          Json // [{path, before, after}]
  thresholdAt   Int?
  signerCountAt Int?
  expiresAt     DateTime?
  adminId       String?
  adminNote     String?
  decidedAt     DateTime?
  appliedAt     DateTime?
  createdAt     DateTime               @default(now())

  approvals CoinCardApproval[]

  @@index([cardId, createdAt])
  @@index([status, createdAt])
}

// Один подписант — один голос (@@unique). Отказ закрывает ревизию, только
// когда порог становится арифметически недостижим — права вето ни у кого нет.
model CoinCardApproval {
  id         String           @id @default(cuid())
  revisionId String
  revision   CoinCardRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  memberId   String
  member     CoinCardMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  decision   CoinCardVote
  comment    String?
  createdAt  DateTime         @default(now())

  @@unique([revisionId, memberId])
  @@index([revisionId])
}

enum CompanyDeletionKind {
  COMPANY
  POINT
}

enum CompanyDeletionStatus {
  PENDING
  APPLIED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum CompanyDeletionVote {
  APPROVE
  REJECT
}

// Узкая мультиподпись: только про удаление и только голосами владельцев.
// Конвейер ревизий карточки монеты сюда не тащим — там решается другая задача.
// thresholdAt/ownerCountAt — снимок на момент подачи: без него уход владельца
// на ходу меняет исход идущего голосования.
model CompanyDeletionRequest {
  id            String                @id @default(cuid())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          CompanyDeletionKind
  pointId       String? // только при kind = POINT
  requestedById String
  requestedBy   User                  @relation("CompanyDeletionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reason        String?               @db.Text
  status        CompanyDeletionStatus @default(PENDING)
  thresholdAt   Int
  ownerCountAt  Int
  expiresAt     DateTime
  decidedAt     DateTime?
  createdAt     DateTime              @default(now())

  approvals CompanyDeletionApproval[]

  @@index([companyId, status])
  @@index([status, expiresAt])
  @@index([pointId])
}

model CompanyDeletionApproval {
  id        String                 @id @default(cuid())
  requestId String
  request   CompanyDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User                   @relation("CompanyDeletionVoter", fields: [userId], references: [id], onDelete: Cascade)
  vote      CompanyDeletionVote
  createdAt DateTime               @default(now())

  @@unique([requestId, userId])
}

// ---------------------------------------------------------------------------
// Слайс AN — управление делами. Один слой процесса поверх всех типов заявок:
// статус самого объекта (CoinCard.status, Company.status …) остаётся источником
// правды для публикации, дело ведёт работу и в конце проставляет этот статус.
// ---------------------------------------------------------------------------

enum CaseSubjectType {
  COIN_CARD
  COMPANY
  POINT
  EXCHANGE
  FINTECH
  KYB
  COIN_REQUEST
  POINT_REPORT
  PRODUCT_CLAIM
  PRODUCT_REPORT
  COMPANY_REVISION
}

enum CaseStatus {
  NEW
  IN_REVIEW
  WAITING_APPLICANT
  READY_FOR_APPROVAL
  APPROVED
  REJECTED
  CLOSED
}

enum CaseRisk {
  LOW
  MEDIUM
  HIGH
}

enum CaseActorSide {
  STAFF
  APPLICANT
  SYSTEM
}

enum CaseEventKind {
  OPENED
  CLAIMED
  RELEASED
  STATUS_CHANGED
  CLOCK_PAUSED
  CLOCK_RESUMED
  TIME_ADJUSTED
  NOTE
  MESSAGE_SENT
  MESSAGE_RECEIVED
  REVIEWED
  CHECK_SET
  DOCUMENT_VERDICT
  DECIDED
  POINT_REPORTED
  POINT_ASKED
  POINT_WARNED
  POINT_SUSPENDED
  COMPANY_WARNED
  COMPANY_SUSPENDED
  COMPANY_RESTORED
  REVIEW_PASSED
  REOPENED
  CLOSED_AS_SPAM
  PRODUCT_REPORTED
  PRODUCT_CLAIMED
  PRODUCT_SUSPENDED
  PRODUCT_RESTORED
  PRODUCT_MERGED
}

enum CaseTimeSource {
  AUTO
  MANUAL
}

/// У сообщения ровно две стороны. Третье значение (SYSTEM из CaseActorSide)
/// нечем было бы нарисовать в нитке, поэтому перечисление своё.
enum CaseMessageSide {
  STAFF
  APPLICANT
}

enum CaseCheckState {
  TODO
  OK
  FAIL
  NA
}

enum CaseDocumentVerdict {
  PENDING
  ACCEPTED
  REJECTED
  RESUBMIT
}

enum CaseDecision {
  APPROVED
  REJECTED
}

enum AdminNotificationKind {
  APPLICANT_REPLIED
  DUE_SOON
  CASE_OVERDUE
  APPLICANT_SILENT
  POINT_REPORTED
  REVIEW_DUE
  ACCESS_REVIEW_DUE
  PRODUCT_REPORTED
}

model ComplianceCase {
  id          String          @id @default(cuid())
  subjectType CaseSubjectType
  subjectId   String
  status      CaseStatus      @default(NEW)
  risk        CaseRisk        @default(MEDIUM)

  /// Снимок названия на момент заведения: очередь должна читаться, даже если
  /// объект мягко удалили.
  title String

  applicantUserId String?
  applicant       User?   @relation("CaseApplicant", fields: [applicantUserId], references: [id], onDelete: SetNull)
  assigneeId      String?
  assignee        User?   @relation("CaseAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  openedAt       DateTime  @default(now())
  /// Момент повторной подачи. Ответы листа проверок, данные до него, ответами
  /// по новой версии объекта не считаются — поэтому дата нужна в самой записи,
  /// а не только в журнале.
  reopenedAt     DateTime?
  dueAt          DateTime
  /// Исходный размер срока в секундах — нужен, чтобы считать порог «жёлтой» точки.
  slaSeconds     Int
  /// Непусто, пока часы срока стоят (ждём ответ заявителя).
  clockStoppedAt DateTime?
  handledSeconds Int       @default(0)
  decidedAt      DateTime?

  /// Первая подпись («проверил»). Вторая («утвердил») обязана принадлежать
  /// другому человеку — пока в системе есть второй сотрудник.
  reviewedById String?
  reviewer     User?     @relation("CaseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  approvedById String?
  approver     User?     @relation("CaseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  /// Утверждено одним лицом — второго сотрудника в системе не было. Молчаливое
  /// послабление было бы хуже отсутствия правила, поэтому это видно в журнале.
  soleSignOff  Boolean   @default(false)

  decision       CaseDecision?
  decisionReason String?

  /// Когда сотрудник впервые написал заявителю. Считается один раз и только
  /// вперёд: это показатель отзывчивости, его нельзя пересчитать потом.
  firstResponseAt DateTime?

  /// Срок следующего пересмотра залистованного предприятия. Выводится из риска
  /// (12 месяцев, при высоком 6) — своей колонки под интервал нет, иначе её
  /// пришлось бы держать в согласии с риском руками.
  nextReviewAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        CaseEvent[]
  checks        CaseCheck[]
  documents     CaseDocument[]
  timeEntries   CaseTimeEntry[]
  messages      CaseMessage[]
  notifications AdminNotification[]

  @@unique([subjectType, subjectId])
  @@index([status, dueAt])
  @@index([assigneeId, status])
  @@index([subjectType, status])
}

/// Неизменяемый журнал дела: только вставка, ни update, ни delete.
model CaseEvent {
  id        String         @id @default(cuid())
  caseId    String
  case      ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?          @relation("CaseEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorSide CaseActorSide  @default(STAFF)
  kind      CaseEventKind
  payload   Json?
  createdAt DateTime       @default(now())

  @@index([caseId, createdAt])
}

/// Сеанс работы над делом. Время в руках — сумма сеансов, а не разница дат.
model CaseTimeEntry {
  id         String         @id @default(cuid())
  caseId     String
  case       ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation("CaseTimeUser", fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  lastBeatAt DateTime
  endedAt    DateTime?
  seconds    Int            @default(0)
  source     CaseTimeSource @default(AUTO)
  note       String?

  @@index([caseId, startedAt])
  @@index([userId, startedAt])
}

/// Одна нитка на дело: слева заявитель, справа мы.
model CaseMessage {
  id          String          @id @default(cuid())
  caseId      String
  case        ComplianceCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?           @relation("CaseMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  side        CaseMessageSide
  body        String
  /// [{ name, filename, size, mime }] — разбирается через parseAttachments.
  attachments Json?

  /// Непрочитанное считается по стороне, а не по человеку: общий стол заявок.
  readByStaffAt     DateTime?
  readByApplicantAt DateTime?

  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@index([side, readByStaffAt])
}

/// Личный колокольчик сотрудника. Непрочитанное с тем же (userId, kind, caseId)
/// не плодится, а обновляется — иначе пять ответов дают пять звонков.
model AdminNotification {
  id     String                @id @default(cuid())
  userId String
  user   User                  @relation("AdminNotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  kind   AdminNotificationKind
  caseId String?
  case   ComplianceCase?       @relation(fields: [caseId], references: [id], onDelete: Cascade)

  /// Кого касается звонок, когда это не дело: сотрудник в ACCESS_REVIEW_DUE.
  /// Без этой привязки «один повод на сотрудника» не отличить от «один повод
  /// вообще».
  subjectId String?

  /// Снимок названия дела: список должен читаться, даже если дело удалили.
  title  String
  body   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([kind, caseId])
  @@index([kind, subjectId])
}

/// Пункт листа проверок. Сам список пунктов живёт в коде
/// (`src/lib/cases/checklists.ts`), строка появляется только когда сотрудник
/// по пункту высказался: иначе список замер бы на том виде, в каком был в день
/// подачи заявки.
model CaseCheck {
  id          String         @id @default(cuid())
  caseId      String
  case        ComplianceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  key         String
  state       CaseCheckState @default(TODO)
  checkedById String?
  checkedBy   User?          @relation("CaseCheckUser", fields: [checkedById], references: [id], onDelete: SetNull)
  checkedAt   DateTime?
  /// Обязательно для FAIL и NA: «не применимо» без причины через год не значит ничего.
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([caseId, key])
  @@index([caseId])
}

/// Документ, по которому сотрудник высказался. Не загружается заново: строки
/// собираются из `Company.kybDocuments` и вложений сообщений заявителя.
model CaseDocument {
  id          String              @id @default(cuid())
  caseId      String
  case        ComplianceCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Источник и вид: KYB_* из анкеты либо MESSAGE_ATTACHMENT из переписки.
  kind        String
  url         String
  label       String?
  verdict     CaseDocumentVerdict @default(PENDING)
  verdictById String?
  verdictBy   User?               @relation("CaseDocumentVerdictUser", fields: [verdictById], references: [id], onDelete: SetNull)
  verdictAt   DateTime?
  verdictNote String?

  createdAt DateTime @default(now())

  @@unique([caseId, url])
  @@index([caseId])
  @@index([verdictById, verdictAt])
}

/// Запись сотрудника комплайнса: должность словами, срок пересмотра доступа,
/// отзыв. Отдельная таблица, а не поля в User: у посетителя их нет и быть не
/// должно.
model StaffMember {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Должность: «старший проверяющий». Видна в аналитике труда.
  title       String?
  /// Обязанности своими словами — то, что владелец пишет при приглашении.
  duties      String?
  invitedById String?
  invitedBy   User?   @relation("StaffMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  startedAt      DateTime @default(now())
  /// Когда владельцу напомнить пересмотреть права: полгода — обычная частота
  /// ревизии доступа в SOC 2 и ISO 27001.
  accessReviewAt DateTime

  /// Доступ отозван. Строка остаётся: журнал решений должен читаться, а
  /// удаление человека стёрло бы, кто что решал.
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?     @relation("StaffMemberRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revokeReason String?
}

/// Право на одну очередь дел. Нет строки — нет доступа (запрет по умолчанию).
model StaffGrant {
  id     String     @id @default(cuid())
  userId String
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ключ очереди из src/lib/cases/queues.ts. Строка, не enum: список очередей
  /// — дело кода, и новая очередь не должна требовать миграции.
  queue  String
  level  StaffLevel

  /// Необязательный срок: доступ «до конца проверки» не живёт вечно.
  expiresAt   DateTime?
  grantedById String?
  grantedBy   User?     @relation("StaffGrantGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, queue])
  @@index([queue, level])
}

/// Приглашение сотрудника: пакет доступа в одной строке. Права отмечаются в
/// момент приглашения и применяются в момент принятия.
model StaffInvite {
  id         String  @id @default(cuid())
  /// Только sha256 ссылки: дамп таблицы не должен давать доступ к админке.
  tokenHash  String  @unique
  /// Кому предназначено, если звали по адресу или логину; у открытой ссылки null.
  identifier String?
  title      String?
  duties     String?
  /// Отмеченные права: [{ queue, level, expiresAt? }].
  grants     Json

  invitedById String
  invitedBy   User   @relation("StaffInviteCreator", fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("StaffInviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?

  @@index([invitedById])
}

enum MfaKind {
  TOTP
}

/// Второй фактор входа сотрудника. Одна строка на человека: больше одного
/// телефона нам пока не просили, а второй ключ рядом с первым означал бы два
/// места, где фактор можно снять незаметно.
model StaffMfa {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        MfaKind   @default(TOTP)
  /// AES-256-GCM, `iv:tag:ciphertext` в base64url. Хешировать ключ нельзя — по
  /// нему считается код, — поэтому дамп таблицы без ключа приложения входа не даёт.
  secretEnc   String
  /// Пока null — заведение начато, но код ни разу не подтверждён: такой фактор
  /// ничего не охраняет и заводится заново поверх.
  confirmedAt DateTime?
  /// Номер последнего принятого шага: код того же или прежнего шага отвергается.
  lastStep    BigInt?
  createdAt   DateTime  @default(now())

  /// Снял владелец. Строка остаётся — журнал того, что фактор был, важнее чистоты таблицы.
  disabledAt     DateTime?
  disabledById   String?
  disabledBy     User?     @relation("StaffMfaDisabler", fields: [disabledById], references: [id], onDelete: SetNull)
  disabledReason String?

  recoveryCodes StaffMfaRecoveryCode[]
}

/// Одноразовый код восстановления. В базе только sha256 — как у токена сброса пароля.
model StaffMfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  mfa       StaffMfa  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  codeHash  String
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  @@unique([userId, codeHash])
  @@index([userId])
}

/// Паспорт товара мира (спека 2026-11-18-product-passport-catalog-design): что это за
/// вещь. Цены и остатка здесь нет — это свойства продавца, а не вещи, и живут они в
/// предложении и на складе (следующий слайс). Паспорт один на товар; у кого есть
/// штрихкод, тот склеивается по нему сам.
model Product {
  id   String  @id @default(cuid())
  slug String  @unique
  /// EAN-13 или EAN-8 с проверенной контрольной цифрой (`parseGtin`). Null — товар без
  /// упаковки: услуга, развес, ручная работа.
  gtin String? @unique

  name             String
  brand            String?
  /// Имя производителя словами, пока он сам не пришёл и не забрал паспорт.
  manufacturerName String?
  category         String
  /// Язык описания (ISO): его читает голосовой синтез браузера, а не язык страницы.
  language         String  @default("en")

  description String  @db.Text
  usage       String? @db.Text
  ingredients String? @db.Text
  /// [{ key, value, unit? }] — свободные пары: у кабеля и у сыра общих колонок не бывает.
  attributes  Json?
  /// [{ url, label? }], до 8.
  photos      Json?
  videoUrl    String?
  /// [{ kind, url, label }], до 10: сертификаты, паспорта, ТУ.
  documents   Json?

  /// Кто завёл. Связь рвётся, а не каскадит: паспорт мира переживает предприятие,
  /// которое его набрало.
  createdByCompanyId String?
  createdByCompany   Company? @relation("ProductCreator", fields: [createdByCompanyId], references: [id], onDelete: SetNull)
  /// Производитель, забравший паспорт одобренной заявкой. Null — хозяина нет, и правит
  /// любое залистованное предприятие.
  ownerCompanyId     String?
  ownerCompany       Company? @relation("ProductOwner", fields: [ownerCompanyId], references: [id], onDelete: SetNull)

  /// Надзор: паспорт снят с каталога до выяснения. Запись остаётся — её видели и по ней
  /// высказались.
  suspendedAt   DateTime?
  suspendReason String?
  suspendedById String?

  /// Признан дублем: страница ведёт на главный паспорт. Снимается одним действием.
  mergedIntoId String?
  mergedInto   Product?  @relation("ProductMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  merged       Product[] @relation("ProductMerge")

  /// Токен, выпущенный сетью. Сайт его не выпускает — только показывает.
  tokenChain String?
  tokenAsset String?

  deletedAt   DateTime?
  deletedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edits        ProductEdit[]
  claims       ProductClaim[]
  revisions    ProductRevision[]
  reports      ProductReport[]
  offers       ProductOffer[]
  balances     StockBalance[]
  tasks        CompanyTask[]
  movements    StockMovement[]
  promos       MerchantPromo[]
  supplyLines  SupplyOrderLine[]
  reorderRules ReorderRule[]

  @@index([category, createdAt])
  @@index([ownerCompanyId])
  @@index([createdByCompanyId])
  @@index([suspendedAt])
  @@index([deletedAt])
}

/// История правок паспорта: только вставка, как CaseEvent. Откат — новая запись
/// (`revertOfId`), а не удаление старой: кто что написал, должно читаться и потом.
model ProductEdit {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  companyId String?
  company   Company? @relation("ProductEditCompany", fields: [companyId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation("ProductEditAuthor", fields: [userId], references: [id], onDelete: SetNull)

  field      String
  before     Json?
  after      Json?
  revertOfId String?

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([companyId, createdAt])
}

/// Заявка производителя на владение паспортом. Решает сотрудник в очереди `products`:
/// доказательством бывает устав, домен, письмо на домене, упаковка.
model ProductClaim {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation("ProductClaimCompany", fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("ProductClaimant", fields: [userId], references: [id], onDelete: Cascade)

  evidence  String @db.Text
  documents Json?

  status       RequestStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?         @relation("ProductClaimDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  rejectReason String?

  createdAt DateTime @default(now())

  @@index([productId, status])
  @@index([companyId, createdAt])
}

enum ProductRevisionStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// Предложение правки паспорту, у которого есть хозяин. Решает сам хозяин, а не
/// администратор платформы: это спор двух предприятий о свойствах их товара. Хозяин,
/// отклоняющий верные правки, ловится жалобой.
model ProductRevision {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation("ProductRevisionCompany", fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation("ProductRevisionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  /// [{ field, after }] — то же устройство, что `diff` у ревизии карточки монеты.
  patch Json

  status      ProductRevisionStatus @default(PENDING)
  decidedById String?
  decidedBy   User?                 @relation("ProductRevisionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  reason      String?

  createdAt DateTime @default(now())

  @@index([productId, status])
  @@index([companyId, createdAt])
}

enum ProductReportReason {
  WRONG_DATA
  FAKE
  NOT_MINE
  ILLEGAL
  OTHER
}

/// Жалоба на паспорт. Фото от анонима не принимаем — то же решение, что у жалоб на точки.
model ProductReport {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  reporterUserId String?
  reporter       User?   @relation("ProductReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  /// sha256 адреса с солью, как в жалобах на точки.
  reporterIpHash String

  reason  ProductReportReason
  comment String?             @db.Text

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([reporterIpHash, productId, createdAt])
}

// ───────────────────────── Склады, остатки и предложения (слайс BC) ─────────────────────────
// Спека `docs/superpowers/specs/2026-11-19-product-offers-warehouses-design.md`.
// Три разные вещи: паспорт (`Product`) — чей товар; предложение (`ProductOffer`) — цена
// продавца; остаток (`StockBalance`) и движение (`StockMovement`) — что у него лежит.

enum WarehouseKind {
  /// Склад 1 из ТЗ — собственный оптовый.
  WHOLESALE
  /// Склад 2 — полка: стоит на точке продаж или в онлайне. По ней считается «где взять».
  SHELF
  /// Склад 3 — сторонний и логистический, в том числе в другой юрисдикции. В «где взять»
  /// не показывается никогда: это чужое плечо, а не место, куда можно прийти.
  THIRD_PARTY
}

model Warehouse {
  id        String        @id @default(cuid())
  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      WarehouseKind
  name      String

  /// Полка стоит на своей одобренной точке — либо в онлайне (`online`). Связь рвётся, а
  /// не каскадит: снос точки не должен стирать записанные движения склада.
  pointId String?
  point   CompanyPoint? @relation(fields: [pointId], references: [id], onDelete: SetNull)
  online  Boolean       @default(false)

  countryCode String?
  address     String?
  note        String? @db.Text

  /// Склад не удаляется, а архивируется: движения по нему уже записаны. Архивировать с
  /// ненулевым остатком нельзя — товар исчез бы молча.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances     StockBalance[]
  movesFrom    StockMovement[] @relation("MoveFrom")
  movesTo      StockMovement[] @relation("MoveTo")
  tasks        CompanyTask[]
  supplyOrders SupplyOrder[]   @relation("SupplyOrderWarehouse")
  reorderRules ReorderRule[]   @relation("ReorderRuleWarehouse")

  @@index([companyId, kind])
  @@index([pointId])
  @@index([archivedAt])
}

/// Остаток — свёртка движений, и он хранится: считать по миллиону движений на каждый
/// показ страницы нельзя, а держать только баланс значило бы не уметь объяснить, откуда
/// он взялся. Пишется в той же транзакции, что движение; расхождение ловит сверка.
model StockBalance {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  qty Decimal @db.Decimal(18, 3)

  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
}

enum StockMoveKind {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUST
}

enum StockMoveStatus {
  /// Товар у перевозчика: с источника списан, приёмнику не зачислен. Третье место, а не
  /// остаток склада — иначе едущий товар существует дважды или исчезает.
  IN_TRANSIT
  DONE
  CANCELLED
}

model StockMovement {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind   StockMoveKind
  status StockMoveStatus @default(DONE)

  fromWarehouseId String?
  fromWarehouse   Warehouse? @relation("MoveFrom", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouseId   String?
  toWarehouse     Warehouse? @relation("MoveTo", fields: [toWarehouseId], references: [id], onDelete: SetNull)

  qty Decimal @db.Decimal(18, 3)

  carrierName  String?
  trackingCode String?
  shippedAt    DateTime?
  expectedAt   DateTime?
  arrivedAt    DateTime?

  note String? @db.Text

  /// Встречное движение отмены ссылается на отменённое: журнал неизменяем, запись не
  /// удаляется, а получает пару.
  reverseOfId String?

  /// Приход по заказу поставщику: иначе через месяц не ответить, откуда взялся приход.
  /// Связь рвётся, а не каскадит — документ может уйти, движение остаётся.
  supplyLineId String?
  supplyLine   SupplyOrderLine? @relation("MovementSupplyLine", fields: [supplyLineId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("StockMovementAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([productId, createdAt])
  @@index([status, companyId])
}

enum OfferStatus {
  ACTIVE
  PAUSED
}

/// Предложение продавца: цена, единица, ставка кэшбэка и правила продажи. Одно на пару
/// «предприятие × товар» — две цены одной вещи у одного продавца означали бы, что
/// покупатель не знает, какая настоящая. Модерацию не проходит: публикует уже
/// залистованное предприятие, снимают те надзоры, что в проекте уже есть.
/// Ставка кэшбэка по категории товаров. Своих групп у продавца в проекте нет, а
/// категория паспорта (BB) — уже готовая общая ось; вторую ось заводить раньше первой
/// нельзя. Действующая ставка считается `effectiveCashback` по правилу «ближайшая к
/// товару побеждает»: ставка товара → категория → «на всё». Не максимальная — иначе
/// продавец не смог бы понизить ставку на отдельный товар.
model CashbackRule {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Ключ из `PRODUCT_CATEGORIES` (список в коде, проза в переводах).
  category String
  percent  Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, category])
  @@index([companyId])
}

model ProductOffer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  price    Decimal @db.Decimal(18, 2)
  /// Фиатная часть того же списка валют, что показывает сайт. В валюту сайта цена не
  /// пересчитывается: пересчёт обещал бы платёж, которого не будет (прецедент — слайс AV).
  currency String
  unit     String  @default("pcs")

  /// Ставка продавца, а не наша выплата: начисление появится вместе с эквайрингом.
  cashbackPercent Decimal? @db.Decimal(5, 2)

  saleRules String? @db.Text
  onlineUrl String?

  status OfferStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, productId])
  @@index([productId, status])
  @@index([companyId, status])
}

/// Подписка человека на магазин (ТЗ 4.2 «избранное»). Строка создаётся нажатием
/// человека и означает согласие на рассылку: рассылку получает только подписчик,
/// рассылок «по всей базе» в проекте нет. `muted` — «следить, но не писать мне».
model CompanyFollow {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation("CompanyFollower", fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  muted     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId, muted])
}

/// Акция магазина: то, что написано на витрине и действует до своего срока. Рассылка —
/// отдельная вещь (`PromoSend`), и по одной акции она делается один раз: повторная
/// рассылка того же текста и есть спам в чистом виде.
model MerchantPromo {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title String
  /// Текст без URL: ссылка в сообщении от незнакомого магазина — дверь для фишинга, а
  /// придёт оно из нашего бота. Переход у акции один, и ставим его мы.
  body  String @db.Text

  startsAt DateTime
  endsAt   DateTime

  /// Привязки необязательны. Снятая точка или снятый паспорт гасят привязку, а не акцию.
  productId String?
  product   Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  pointId   String?
  point     CompanyPoint? @relation(fields: [pointId], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  /// Штамп единственной рассылки по этой акции.
  sentAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sends  PromoSend[]
  clicks PromoClick[]

  @@index([companyId, archivedAt])
  @@index([pointId, endsAt])
  @@index([productId, endsAt])
}

/// Однократная рассылка по акции: кто послал и что из этого вышло. Числа по каналам
/// денормализованы — их читает мерчант на своём экране, а не выгрузка.
model PromoSend {
  id      String        @id @default(cuid())
  promoId String
  promo   MerchantPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  senderUserId String?
  sender       User?   @relation("PromoSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  followers Int @default(0)
  delivered Int @default(0)
  skipped   Int @default(0)

  createdAt DateTime @default(now())

  deliveries PromoDelivery[]

  @@index([promoId, createdAt])
}

enum PromoDeliveryOutcome {
  TELEGRAM
  EMAIL
  WEBPUSH
  /// Пропуски — с причиной, потому что «не ушло» без причины ничего не говорит.
  SKIPPED_MUTED
  SKIPPED_OFF
  SKIPPED_CAP
  SKIPPED_NO_CHANNEL
}

/// Строка «кому и что из этого вышло». На ней же считается суточный потолок получателя:
/// потолок принадлежит человеку, а не магазину.
model PromoDelivery {
  id     String    @id @default(cuid())
  sendId String
  send   PromoSend @relation(fields: [sendId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PromoRecipient", fields: [userId], references: [id], onDelete: Cascade)

  outcome   PromoDeliveryOutcome
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([sendId, outcome])
}

/// Переход по нашей ссылке. Показы не считаем вовсе: честно считает их только счётчик в
/// браузере, которого у нас нет, а приписать показ акции просмотру страницы — врать.
model PromoClick {
  id      String        @id @default(cuid())
  promoId String
  promo   MerchantPromo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("PromoClicker", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([promoId, createdAt])
}

// ───────────────────────────── Поставки (слайс BI) ─────────────────────────────
// Спека `docs/superpowers/specs/2026-11-19-supplier-portal-autoorder-design.md`.

/// Поставщик. Третьего вида учётной записи мы не заводим: поставщик либо сам есть
/// предприятие платформы (тогда портал — его собственный кабинет), либо это
/// запись-контакт без портала вовсе. Приглашение ссылкой заводило бы `Company` в обход
/// очереди модерации.
model Supplier {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("SupplierOwner", fields: [companyId], references: [id], onDelete: Cascade)

  name String

  /// Поставщик на платформе — у него есть портал. Связь рвётся, а не каскадит: уход
  /// предприятия-поставщика не должен стирать записанные заказы покупателя.
  supplierCompanyId String?
  supplierCompany   Company? @relation("SupplierCompany", fields: [supplierCompanyId], references: [id], onDelete: SetNull)

  contactName String?
  email       String?
  phone       String?
  note        String? @db.Text

  /// Поставщик архивируется, а не удаляется: заказы по нему записаны.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       SupplyOrder[]
  reorderRules ReorderRule[]

  @@index([companyId, archivedAt])
  @@index([supplierCompanyId])
}

enum SupplyOrderStatus {
  /// Собирается покупателем; поставщик его не видит. Сюда же ложится черновик автозаказа.
  DRAFT
  SENT
  /// Поставщик подтвердил срок.
  CONFIRMED
  DECLINED
  SHIPPED
  /// Принято по всем строкам — или закрыто покупателем раньше.
  RECEIVED
  CANCELLED
}

/// Заказ поставщику — документ, а не платёж: цена справочная, ни счёта, ни долга мы не
/// считаем (правило линии мерчантов — денежной логики не заводим). Подтверждает и
/// отправляет поставщик, принимает покупатель: остаток меняет только приёмка покупателя.
model SupplyOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("SupplyOrderBuyer", fields: [companyId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  /// Куда везти. Связь рвётся, а не каскадит: архивация склада не уносит документ.
  warehouseId String?
  warehouse   Warehouse? @relation("SupplyOrderWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)

  status   SupplyOrderStatus @default(DRAFT)
  currency String            @default("USD")

  /// Срок, который просит покупатель, и срок, который назвал поставщик, — два разных
  /// числа: подтверждение срока и есть суть портала.
  expectedAt   DateTime?
  confirmedEta DateTime?

  note          String? @db.Text
  declineReason String?
  cancelReason  String?

  /// Черновик собран прогоном автозаказа, а не человеком: отправка остаётся за человеком.
  autoDrafted Boolean @default(false)

  /// Накладные и акты — приватные файлы, список тот же JSONB, что у вложений переписки.
  docs Json?

  sentAt      DateTime?
  confirmedAt DateTime?
  shippedAt   DateTime?
  closedAt    DateTime?

  createdById String?
  createdBy   User?   @relation("SupplyOrderAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines SupplyOrderLine[]

  @@index([companyId, status])
  @@index([supplierId, status])
  @@index([createdAt])
}

model SupplyOrderLine {
  id      String      @id @default(cuid())
  orderId String
  order   SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  qty         Decimal @db.Decimal(18, 3)
  /// Принято — строкой, а не заказом: недовоз обычное дело.
  receivedQty Decimal @default(0) @db.Decimal(18, 3)

  /// Цена поставщика справочная: платежа у нас нет.
  price Decimal? @db.Decimal(18, 2)
  unit  String   @default("pcs")
  note  String?

  createdAt DateTime @default(now())

  movements StockMovement[] @relation("MovementSupplyLine")

  @@index([orderId])
  @@index([productId])
}

/// Правило автозаказа: порог на паре «склад × товар». Поставщик обязателен — заявку
/// иначе некому адресовать, а правило без адресата это сигнал, которого мы не шлём.
model ReorderRule {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation("ReorderRuleCompany", fields: [companyId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation("ReorderRuleWarehouse", fields: [warehouseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  minQty    Decimal @db.Decimal(18, 3)
  targetQty Decimal @db.Decimal(18, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productId])
  @@index([companyId])
  @@index([supplierId])
}
