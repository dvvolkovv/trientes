  displayName String
  logoUrl     String?
  description String?
  website     String
  country     String
  email       String
  phone       String?
  address     String?
  socials     Json?

  status          ExchangeStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([status, createdAt])
