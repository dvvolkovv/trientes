model ExchangeMarket {
  id              String    @id // "{exchangeId}:{base}:{quote}:{category}"
  exchangeId      String
  pair            String // display label, e.g. "BTC/USDT"
  baseSymbol      String
  quoteSymbol     String
  baseCurrencyId  String? // CoinPaprika id, e.g. "btc-bitcoin"
  quoteCurrencyId String?
  category        String? // "spot" | "perpetual" | "futures" | "other"
  priceUsd        Float?
  volumeUsd24h    Float?
  volumeSharePct  Float? // adjusted_volume_share from CoinPaprika
  outlier         Boolean   @default(false)
  marketUrl       String?
  lastTradedAt    DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  exchange        Exchange  @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([exchangeId, volumeUsd24h(sort: Desc)])
  @@index([exchangeId, firstSeenAt(sort: Desc)])
  @@index([exchangeId, lastSeenAt])
}

model ExchangeWatchlist {
  userId     String
  exchangeId String
  addedAt    DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@id([userId, exchangeId])
  @@index([userId])
}

// Закладка на монету, которая живёт одной карточкой. Отдельная таблица, а не
// колонка в `Watchlist`: там `coinId` — внешний ключ на `Coin`, а у такой
// монеты строки `Coin` нет по замыслу (рыночного фида у неё не существует), и
// кнопка закладки в списке просто не рисовалась. Тот же приём уже применён к
// биржам — `ExchangeWatchlist`.
model CardWatchlist {
  userId   String
  cardSlug String
  addedAt  DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     CoinCard @relation(fields: [cardSlug], references: [slug], onDelete: Cascade)

  @@id([userId, cardSlug])
  @@index([userId])
}

// Оценка монеты посетителем: одна оценка на человека, её можно изменить или
// снять. Внешнего ключа нет намеренно: оценка относится к монете, которую
// посетитель видит по адресу `/coin/<coinKey>`, а эта монета бывает строкой
// `Coin`, карточкой `CoinCard` или обеими сразу — ключ один, страница одна, и
// оценка не должна зависеть от того, с какой стороны монета заведена.
// В базе все `Coin.slug` равны `Coin.id`, а у карточки свой `slug @unique`,
// поэтому адрес страницы — единственная общая опора.
model CoinRating {
  id        String   @id @default(cuid())
  coinKey   String
  userId    String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, coinKey])
  @@index([coinKey])
}

enum PointType {
  SHOP
  ATM
  POS
  SALES_OFFICE
  COMPANY
  ONLINE
}

model Company {
  id              String          @id @default(cuid())
  ownerUserId     String
  owner           User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  members         CompanyMember[]
  invites         CompanyInvite[]
  legalName       String
  displayName     String
  logoUrl         String?
  description     String?         @db.Text
  /// Вид заведения из реестра `src/lib/merchant-categories.ts` (слайс BN). Уточнение
  /// у точки сильнее: `effectiveCategory`. Свободное поле — вид не меняет ни места,
  /// ни принимаемых монет, ни хозяина.
  category        String?
  /// Политика возврата. ТЗ § 3.1 требует показывать её покупателю; не указана —
  /// так и пишем, промолчать значит создать впечатление, которого мы не вправе
  /// создавать.
  returnPolicy    String?         @db.Text
  returnDays      Int?
  country         String?
  countryCode     String?
  city            String?
  street          String?
  houseNumber     String?
  postalCode      String?
  address         String?
  phone           String?
  email           String?
  website         String?
  socials         Json?
  status          RequestStatus   @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewer        User?           @relation("CompanyReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  points          CompanyPoint[]

  kybStatus          KybStatus @default(NONE)
  kybDocuments       Json? // [{ kind, url, label }]
  kybSubmittedAt     DateTime?
  kybReviewedAt      DateTime?
  kybRejectionReason String?

  // Надзор: предприятие снято с витрины до выяснения. Статус APPROVED при этом
  // не трогаем — это мера надзора, а не отмена решения модератора, и вернуть
  // предприятие должно быть одним действием, а не проходом через очередь.
  suspendedAt   DateTime?
  suspendReason String?
  suspendedById String?

  coinCards CoinCard[]

  // Мягкое удаление: данные остаются, но объект выпадает из всех выборок.
  // Жёсткий каскад снёс бы точки, членства, приглашения и KYB-документы и
  // оставил бы висячие targetId в журнале админа.
  deletedAt   DateTime?
  deletedById String?

  deletionRequests CompanyDeletionRequest[]

  productsCreated  Product[]         @relation("ProductCreator")
  productsOwned    Product[]         @relation("ProductOwner")
  productEdits     ProductEdit[]     @relation("ProductEditCompany")
  productClaims    ProductClaim[]    @relation("ProductClaimCompany")
  productRevisions ProductRevision[] @relation("ProductRevisionCompany")
  warehouses       Warehouse[]
  stockMovements   StockMovement[]
  productOffers    ProductOffer[]

  /// Ставка кэшбэка «на всё» — слово продавца, а не наша выплата: начисление появится
  /// вместе с эквайрингом. Пусто значит «ставки нет», а не «ноль процентов».
  cashbackBasePercent Decimal?       @db.Decimal(5, 2)
  cashbackRules       CashbackRule[]

  teamRoles CompanyTeamRole[]
  actionLog CompanyActionLog[]
  tasks     CompanyTask[]
  followers CompanyFollow[]
  promos    MerchantPromo[]

  // Поставки (BI). «Заказы нам» читаются через `Supplier.supplierCompany`: заказ
  // принадлежит покупателю, а поставщик — его адресат, а не второй владелец.
  suppliers    Supplier[]    @relation("SupplierOwner")
  supplierFor  Supplier[]    @relation("SupplierCompany")
  supplyOrders SupplyOrder[] @relation("SupplyOrderBuyer")
  reorderRules ReorderRule[] @relation("ReorderRuleCompany")

  /// Правки карточки, ждущие модератора (BM). Витрина держит прежнее значение.
  revisions CompanyRevision[]

  /// Общий чат команды (BP). Одна комната на предприятие: ТЗ 6.6 просит «общий чат
  /// команды», а канал, в который никто не пишет, хуже его отсутствия.
  chatMessages CompanyChatMessage[]
  chatReads    CompanyChatRead[]

  @@index([ownerUserId])
  @@index([status, createdAt])
  @@index([kybStatus])
  @@index([deletedAt])
  @@index([suspendedAt])
}

/// Правка карточки предприятия, ждущая решения модератора.
///
/// Витрина держит прежние значения, пока правку не одобрят — поэтому новые значения
/// живут здесь, а не в `Company`. Объект дела — сама правка, а не предприятие: у
/// предприятия уже есть своё дело (@@unique(subjectType, subjectId)), а правок во
/// времени будет много, и каждой нужно своё дело (тот же разбор, что у `ProductClaim`).
model CompanyRevision {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Автор правки. SetNull, а не Restrict: уборка AU уже упиралась в RESTRICT у
  /// AdminAuditLog.actorId, и удаление человека не должно держать строку.
  authorId  String?
  author    User?   @relation("CompanyRevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// [{ field, before, after }] — то же устройство, что `patch` у ревизии паспорта.
  changes Json
  /// Документы, присланные к правке юридического имени: [{ kind, url, label }].
  documents Json?

  status      RequestStatus @default(PENDING)
  decidedById String?
  decidedBy   User?         @relation("CompanyRevisionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  reason      String?

  createdAt DateTime @default(now())

  @@index([companyId, status])
  @@index([status, createdAt])
}

model CompanyPoint {
  id              String               @id @default(cuid())
  companyId       String
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type            PointType
  name            String
  description     String?              @db.Text
  lat             Float?
  lon             Float?
  countryCode     String?
  city            String?
  street          String?
  houseNumber     String?
  postalCode      String?
  address         String?
  acceptedCoinIds String[]
  // Собственные листинги (CoinCard.id). Параллельный массив, а не магические
  // строки "card:<id>" внутри acceptedCoinIds: те тихо сломали бы любой
  // существующий acceptedCoinIds.includes(coin.id).
  acceptedCardIds String[]
  // Точка зеркала BTC Map, которую предприятие забрало себе («это моё
  // предприятие»). Строка вида "node:123" — тот же ключ, что у `OsmCryptoPoi.id`.
  // Пока заявка не одобрена, на карте стоит чужая точка; после одобрения фид
  // прячет зеркальную, иначе одно заведение показывалось бы двумя булавками.
  osmId           String?
  logoUrl         String?
  photos          Json? // [{ url, label? }], max 5
  /// Часы работы текстом. Остаётся ради точки зеркала BTC Map: там это строка из
  /// тегов OSM, и единственное, что мы о тех часах знаем. Структурные `hours`
  /// сильнее — состояние «открыто сейчас» считается только по ним.
  openingHours    String?
  /// Расписание по дням недели (слайс BN): { mon: { kind, spans } }. Разбор —
  /// `parseWeekHours`; синтаксис OSM мы не разбираем и не пишем.
  hours           Json?
  /// Часовой пояс заведения (IANA). Без него «открыто сейчас» не считается вовсе:
  /// сервер стоит в UTC, браузер покупателя — в его поясе, и ни один из них не
  /// пояс магазина.
  timezone        String?
  /// Вид заведения, уточняющий категорию предприятия (слайс BN).
  category        String?
  phone           String?
  website         String?
  socials         Json?
  status          RequestStatus        @default(PENDING)
  reviewedById    String?
  reviewer        User?                @relation("PointReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectReason    String?
  // Жалоб набралось достаточно: точка видна на карте с пометкой «проверяется».
  underReviewAt   DateTime?
  // Точка снята с карты до выяснения. Статус APPROVED при этом не трогаем:
  // снятие — мера надзора, а не отмена прошлого решения модератора.
  suspendedAt     DateTime?
  suspendReason   String?
  reports         PointReport[]
  promos          MerchantPromo[]
  // Полки, стоящие на этой точке (слайс BC).
  warehouses      Warehouse[]
  // Участки сотрудников, в которые входит эта точка (слайс BE).
  memberScopes    CompanyMemberPoint[]
  tasks           CompanyTask[]
  // Мягкое удаление, как у компании.
  deletedAt       DateTime?
  deletedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([osmId])
  @@index([status])
  @@index([companyId])
  @@index([lat, lon])
  @@index([acceptedCardIds(ops: ArrayOps)], type: Gin)
  @@index([deletedAt])
  @@index([suspendedAt])
}

/// Причина жалобы. Свободный текст лежит в comment — перечисление нужно, чтобы
/// считать однотипные жалобы, а не читать двести предложений.
enum PointReportReason {
  CLOSED
  NO_CRYPTO
  WRONG_ADDRESS
  OTHER
}

/// Жалоба посетителя на точку. Одна строка на жалобу; все жалобы по одной точке
/// собираются в одно дело (ComplianceCase с subjectType = POINT_REPORT).
model PointReport {
  id             String            @id @default(cuid())
  pointId        String
  point          CompanyPoint      @relation(fields: [pointId], references: [id], onDelete: Cascade)
  reporterUserId String?
  reporter       User?             @relation("PointReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  /// sha256 адреса с солью: сам адрес хранить незачем, считать независимость — да.
  reporterIpHash String
  reason         PointReportReason
  comment        String?           @db.Text
  /// Спека называет фото; форма его пока не принимает (границы слайса AQ).
  photoUrl       String?
  createdAt      DateTime          @default(now())

  @@index([pointId, createdAt])
  @@index([reporterIpHash, pointId, createdAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  ip         String
  identifier String
  success    Boolean
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([ip, createdAt])
  @@index([identifier, createdAt])
}

// Одноразовая ссылка для смены забытого пароля. В базе лежит только sha256
// токена — ссылка есть лишь в письме.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("PasswordResets", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum ExchangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// User-submitted exchange registrations awaiting admin moderation.
// NOTE: The existing "Exchange" model is the CoinGecko catalog (public exchange data).
// This model is named "RegisteredExchange" to avoid collision with that table.
model RegisteredExchange {
