generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  /// Сотрудник комплайнса: может ровно то, что выдано строками StaffGrant.
  STAFF
  /// Владелец: все очереди на уровне APPROVE плюс то, что делом не является.
  OWNER
  /// Наследие. Читается политикой как OWNER (src/lib/authz/policy.ts): убрать
  /// значение из типа Postgres внутри одной миграции нельзя, а оставить его
  /// бесправным значило бы запереть живую запись владельца.
  ADMIN
}

/// Уровень доступа сотрудника к одной очереди дел. Порядок значим:
/// APPROVE включает HANDLE, HANDLE включает VIEW.
enum StaffLevel {
  VIEW
  HANDLE
  APPROVE
}

model User {
  id                       String                    @id @default(cuid())
  email                    String?                   @unique
  name                     String?
  image                    String?
  username                 String?                   @unique
  passwordHash             String?
  firstName                String?
  lastName                 String?
  phone                    String?
  role                     Role                      @default(USER)
  preferredLocale          String                    @default("en")
  preferredCurrency        String                    @default("USD")
  preferredTheme           String                    @default("system")
  emailVerified            DateTime?
  createdAt                DateTime                  @default(now())
  accounts                 Account[]
  sessions                 Session[]
  watchlist                Watchlist[]
  exchangeWatchlist        ExchangeWatchlist[]
  cardWatchlist            CardWatchlist[]
  coinRatings              CoinRating[]
  coinRequests             CoinRequest[]
  adminAddedCoins          Coin[]                    @relation("AdminCoinAdditions")
  reviewedRequests         CoinRequest[]             @relation("RequestReviewer")
  auditLogs                AdminAuditLog[]           @relation("AdminAuditActor")
  companies                Company[]
  registeredExchanges      RegisteredExchange[]
  reviewedPoints           CompanyPoint[]            @relation("PointReviewer")
  reviewedCompanies        Company[]                 @relation("CompanyReviewer")
  loginAttempts            LoginAttempt[]
  passwordResets           PasswordResetToken[]      @relation("PasswordResets")
  ownedFintechs            FintechCompany[]          @relation("FintechOwner")
  reviewedFintechs         FintechCompany[]          @relation("FintechReviewer")
  priceAlerts              PriceAlert[]
  geoAlerts                GeoAlert[]
  companyMemberships       CompanyMember[]
  companyActions           CompanyActionLog[]
  tasksCreated             CompanyTask[]             @relation("CompanyTaskAuthor")
  tasksAssigned            CompanyTask[]             @relation("CompanyTaskAssignee")
  tasksTaken               CompanyTask[]             @relation("CompanyTaskTaker")
  tasksClosed              CompanyTask[]             @relation("CompanyTaskCloser")
  chatMessages             CompanyChatMessage[]       @relation("CompanyChatAuthor")
  chatReads                CompanyChatRead[]
  taskComments             CompanyTaskComment[]      @relation("CompanyTaskCommentAuthor")
  companyInvitesCreated    CompanyInvite[]           @relation("CompanyInviteCreator")
  companyInvitesAccepted   CompanyInvite[]           @relation("CompanyInviteAcceptor")
  pushSubscriptions        PushSubscription[]
  notifyTelegram           Boolean                   @default(true)
  notifyEmail              Boolean                   @default(false)
  notifyWebPush            Boolean                   @default(false)
  /// Общий выключатель рассылок магазинов (ТЗ 4.3). Канальные выключатели старше:
  /// выключивший почту не получит почту и от магазина.
  notifyPromos             Boolean                   @default(true)
  /// Интересы человека и два его числа (ТЗ 4.4, слайс BK). Коридор — насколько далеко
  /// от линии маршрута место ещё считается «по пути»; подсказка — за сколько до
  /// отмеченной точки сказать голосом.
  routeCorridorMeters      Int                       @default(1500)
  routeAlertMeters         Int                       @default(1500)
  interests                UserInterest[]
  coinCardsStewarded       CoinCard[]                @relation("CoinCardSteward")
  coinCardClaims           CoinCardClaim[]           @relation("CoinCardClaimant")
  coinCardsReviewed        CoinCard[]                @relation("CoinCardReviewer")
  coinCardMemberships      CoinCardMember[]          @relation("CoinCardMemberUser")
  coinCardInvitesMade      CoinCardInvite[]          @relation("CoinCardInviteCreator")
  coinCardInvitesGot       CoinCardInvite[]          @relation("CoinCardInviteAcceptor")
  coinCardRevisions        CoinCardRevision[]        @relation("CoinCardRevisionAuthor")
  companyDeletionRequests  CompanyDeletionRequest[]  @relation("CompanyDeletionRequester")
  companyDeletionApprovals CompanyDeletionApproval[] @relation("CompanyDeletionVoter")
  casesApplied             ComplianceCase[]          @relation("CaseApplicant")
  casesAssigned            ComplianceCase[]          @relation("CaseAssignee")
  caseEvents               CaseEvent[]               @relation("CaseEventActor")
  caseTimeEntries          CaseTimeEntry[]           @relation("CaseTimeUser")
  caseMessages             CaseMessage[]             @relation("CaseMessageAuthor")
  adminNotifications       AdminNotification[]       @relation("AdminNotificationUser")
  staffMember              StaffMember?
  staffGrants              StaffGrant[]
  staffGrantsMade          StaffGrant[]              @relation("StaffGrantGranter")
  staffInvitesMade         StaffInvite[]             @relation("StaffInviteCreator")
  staffInvitesGot          StaffInvite[]             @relation("StaffInviteAcceptor")
  staffMembersInvited      StaffMember[]             @relation("StaffMemberInviter")
  staffAccessRevoked       StaffMember[]             @relation("StaffMemberRevoker")
  mfa                      StaffMfa?
  mfaDisabled              StaffMfa[]                @relation("StaffMfaDisabler")
  pointReports             PointReport[]             @relation("PointReporter")
  casesReviewed            ComplianceCase[]          @relation("CaseReviewer")
  casesApproved            ComplianceCase[]          @relation("CaseApprover")
  caseChecks               CaseCheck[]               @relation("CaseCheckUser")
  caseDocumentVerdicts     CaseDocument[]            @relation("CaseDocumentVerdictUser")
  productEdits             ProductEdit[]             @relation("ProductEditAuthor")
  productClaims            ProductClaim[]            @relation("ProductClaimant")
  productClaimsDecided     ProductClaim[]            @relation("ProductClaimDecider")
  productRevisions         ProductRevision[]         @relation("ProductRevisionAuthor")
  productRevisionsDecided  ProductRevision[]         @relation("ProductRevisionDecider")
  companyRevisions         CompanyRevision[]         @relation("CompanyRevisionAuthor")
  companyRevisionsDecided  CompanyRevision[]         @relation("CompanyRevisionDecider")
  productReports           ProductReport[]           @relation("ProductReporter")
  stockMovements           StockMovement[]           @relation("StockMovementAuthor")
  companyFollows           CompanyFollow[]           @relation("CompanyFollower")
  promoSends               PromoSend[]               @relation("PromoSender")
  promoDeliveries          PromoDelivery[]           @relation("PromoRecipient")
  promoClicks              PromoClick[]              @relation("PromoClicker")
  supplyOrders             SupplyOrder[]             @relation("SupplyOrderAuthor")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([userId])
}

enum CompanyRole {
  OWNER
  EDITOR
  VIEWER
}

model PageView {
  id        String   @id @default(cuid())
  path      String // canonical path including locale, e.g. "/en/coin/bitcoin"
  locale    String? // extracted from path for fast aggregation
  sessionId String? // anonymous 30-day rolling cookie (UUID); null for prerendered bot hits
  userId    String? // populated when the viewer is signed in
  referrer  String? // document.referrer at hit time; null for direct
  country   String? // ISO-2 from CF-IPCountry header when present
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId, createdAt])
  @@index([country, createdAt])
}

enum KybStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model CompanyMember {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CompanyRole @default(VIEWER)
  invitedById String?
  createdAt   DateTime    @default(now())

  /// Своя роль предприятия (слайс BE). Пусто — работает наследие фазы 10: `EDITOR`
  /// правит все разделы, `VIEWER` смотрит. Бэкфилл «завести каждому предприятию по
  /// роли» завёл бы роли тем, кто о них не просил.
  roleId   String?
  teamRole CompanyTeamRole?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  /// Участок: точки продаж, которыми член ограничен. Пусто — все точки.
  points   CompanyMemberPoint[]

  @@unique([companyId, userId])
  @@index([userId])
  @@index([roleId])
}

/// Роль, собранная мерчантом в конструкторе (ТЗ 6.6). Набор прав лежит JSONB и
/// разбирается `parsePermissions` с запретом по умолчанию: неизвестный раздел
/// выбрасывается, негодный уровень означает «нельзя».
model CompanyTeamRole {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  /// { card|points|products|warehouses|pricing: "VIEW"|"EDIT" }
  permissions Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members CompanyMember[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Точка участка. Снос точки снимает строку каскадом: участок — это ссылки на живые
/// точки, а не журнал.
model CompanyMemberPoint {
  id       String        @id @default(cuid())
  memberId String
  member   CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pointId  String
  point    CompanyPoint  @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([memberId, pointId])
  @@index([pointId])
}

/// Журнал действий предприятия: кто, что и когда изменил (ТЗ 6.6). Только вставка.
/// Автор снимается в SET NULL, а не RESTRICT: уборка AU уже упиралась в
/// `AdminAuditLog.actorId` с RESTRICT — удаление пробной учётки блокировало транзакцию.
model CompanyActionLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Код действия: "PRODUCT_UPDATED", "MOVEMENT_RECORDED", "MEMBER_ROLE_SET"…
  action      String
  /// Человеку видимое имя затронутого объекта (товар, склад, точка, сотрудник).
  subject     String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Задача команды (ТЗ 6.6). Статусы — четыре рабочих плюс отмена; «на проверке» имеет
/// смысл только потому, что принять работу вправе не тот, кто её сдавал. Задача не
/// удаляется: отменённая остаётся строкой, как движение склада и строка журнала.
model CompanyTask {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title    String
  details  String?             @db.Text
  status   CompanyTaskStatus   @default(NEW)
  priority CompanyTaskPriority @default(NORMAL)
  /// Срок — дата, хранится концом дня по UTC: часового пояса у предприятия нет.
  dueAt    DateTime?

  /// Авторы снимаются в SET NULL, а не RESTRICT: удаление учётной записи не должно
  /// блокировать транзакцию (уборка AU уже упиралась в это с `AdminAuditLog`).
  createdById String?
  createdBy   User?   @relation("CompanyTaskAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Кому поручено и кто взял — два разных поля: ТЗ просит видеть оба.
  assigneeId String?
  assignee   User?     @relation("CompanyTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedAt DateTime?
  takenById  String?
  takenBy    User?     @relation("CompanyTaskTaker", fields: [takenById], references: [id], onDelete: SetNull)
  takenAt    DateTime?

  /// Кто сдал на проверку: он же не вправе принять свою работу.
  submittedById String?
  submittedAt   DateTime?

  closedById   String?
  closedBy     User?     @relation("CompanyTaskCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt     DateTime?
  cancelReason String?

  /// Привязки. Связь рвётся, а не каскадит: архивация склада и снос точки не уносят
  /// поручение. Акции в проекте нет, и поля под неё не заводим (решение BD/BC).
  pointId     String?
  point       CompanyPoint? @relation(fields: [pointId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  warehouseId String?
  warehouse   Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments CompanyTaskComment[]

  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([assigneeId, status])
  @@index([pointId])
  @@index([dueAt])
}

/// Обсуждение внутри задачи. Общий чат команды из того же пункта ТЗ — отдельная линия
/// со своей моделью и своим непрочитанным.
model CompanyTaskComment {
  id           String      @id @default(cuid())
  taskId       String
  task         CompanyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorUserId String?
  author       User?       @relation("CompanyTaskCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String      @db.Text
  createdAt    DateTime    @default(now())

  @@index([taskId, createdAt])
}

/// Сообщение общего чата команды (BP, ТЗ 6.6). Разговор, а не поручение: у него нет ни
/// исполнителя, ни срока — это и отличает его от задачи (`CompanyTask`, BF).
model CompanyChatMessage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Автор снимается `SET NULL`, а не `RESTRICT`: удаление учётной записи не должно
  /// блокировать транзакцию (уборка AU уже упиралась в это с `AdminAuditLog`). Слова
  /// уволенного остаются в разговоре: он их сказал.
  authorUserId String?
  author       User?   @relation("CompanyChatAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  body String @db.Text

  /// Упомянутые — ровно те, кому ушло уведомление каналами. Скалярный список, а не
  /// таблица: соединением по нему не ходят, а имена разрешаются по членам команды.
  mentions String[]

  /// Отзыв: строка остаётся, текст на экране заменяется словами «сообщение удалено».
  /// Правки нет — она меняет смысл сказанного под ней (журналы проекта неизменяемы).
  deletedAt   DateTime?
  deletedById String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Час последнего чтения комнаты — на человека, а не на сторону. Это отход от
/// `CaseMessage` (AO), где смена гасит «непрочитано» друг за друга: там дело ведёт
/// смена, а здесь сообщение адресовано команде и ждёт каждого.
model CompanyChatRead {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

enum CompanyTaskStatus {
  NEW
  IN_PROGRESS
  ON_REVIEW
  DONE
  CANCELLED
}

enum CompanyTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Shareable invite link. Created by an OWNER when the person being invited has
// no Trientes account yet (inviteMember() can only add users that already
// exist). Single-use, expires after INVITE_TTL_DAYS, revocable.
model CompanyInvite {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role         CompanyRole @default(VIEWER)
  token        String      @unique
  createdById  String
  createdBy    User        @relation("CompanyInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  acceptedById String?
  acceptedBy   User?       @relation("CompanyInviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([companyId, createdAt])
}

enum AlertOp {
  GTE
  LTE
}

model PriceAlert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  coinId    String // CoinGecko id (e.g. "bitcoin")
  symbol    String // denormalized for fast display in cabinet + notification
  op        AlertOp
  threshold Float // USD

  enabled     Boolean   @default(true)
  triggered   Boolean   @default(false) // re-arms with 3% hysteresis
  lastFiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
  @@index([enabled, coinId])
}

model GeoAlert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  countryCode String // ISO-3166-1 alpha-2

  enabled       Boolean @default(true)
  notifyFintech Boolean @default(true)
  notifyPoints  Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([userId, countryCode])
  @@index([countryCode, enabled])
}

/// Отметка «нравится / не нравится» по оси интересов (`src/lib/interests.ts`).
/// Отметок нет вовсе — показываем все пять: молчание не значит «ничего не показывать».
/// «Не нравится» убирает интерес из списка по пути и из голоса, но **не с карты**:
/// карта показывает действительность.
model UserInterest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key     String // InterestKey: fuel | food | lodging | shop | cash
  verdict InterestVerdict

  createdAt DateTime @default(now())

  @@unique([userId, key])
}

enum InterestVerdict {
  LIKE
  DISLIKE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  /// Когда в этом сеансе был показан второй фактор. Фактор проверяется на
  /// сеансе, а не внутри входа: провайдеров входа четыре (пароль, Google,
  /// GitHub, Telegram), и встраивать проверку в каждый — четыре места, где
  /// можно забыть. Один охранник там же, где читается право на очередь.
  mfaAt        DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum CoinSource {
  AUTO_L1
  ADMIN_ADDED
}

model Coin {
  id                    String         @id // CoinGecko id, e.g. "bitcoin"
  symbol                String
  name                  String
  slug                  String         @unique
  rank                  Int
  logoUrl               String?
  source                CoinSource     @default(AUTO_L1)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  description           String?        @db.Text
  websiteUrl            String?
  explorerUrl           String?
  whitepaperUrl         String?
  githubUrl             String?
  twitterUrl            String?
  redditUrl             String?
  metadataFetchedAt     DateTime?
  addedByAdminId        String?
  approvedFromRequestId String?        @unique
  addedBy               User?          @relation("AdminCoinAdditions", fields: [addedByAdminId], references: [id])
  approvedFromRequest   CoinRequest?   @relation("CoinRequestApproved", fields: [approvedFromRequestId], references: [id])
  snapshots             CoinSnapshot[]
  watchedBy             Watchlist[]
  card                  CoinCard?      @relation("CoinCardCoin")
}

model CoinSnapshot {
  id                String   @id @default(cuid())
  coinId            String
  coin              Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)
  priceUsd          Decimal  @db.Decimal(24, 10)
  marketCapUsd      Decimal  @db.Decimal(30, 2)
  volume24hUsd      Decimal  @db.Decimal(30, 2)
  pctChange1h       Float?
  pctChange24h      Float?
  pctChange7d       Float?
  circulatingSupply Decimal? @db.Decimal(30, 2)
  totalSupply       Decimal? @db.Decimal(30, 2)
  maxSupply         Decimal? @db.Decimal(30, 2)
  sparkline7d       Json?
  fetchedAt         DateTime @default(now())

  @@index([coinId, fetchedAt])
}

model GlobalStats {
  id                Int      @id @default(1)
  totalMarketCapUsd Decimal  @db.Decimal(30, 2)
  total24hVolumeUsd Decimal  @db.Decimal(30, 2)
  btcDominancePct   Float
  ethDominancePct   Float
  activeCryptos     Int
  markets           Int
  fetchedAt         DateTime @default(now())
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CoinCardSection {
  IDENTITY
  CONTRACTS
  TOKENOMICS
  MARKETS
  SECURITY
  TEAM
  LINKS
  MARKETING
  ACCEPTANCE
  PAYMENTS
  LEGAL
}

enum CoinCardRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CoinCardTrust {
  UNVERIFIED
  CONTRACT_VERIFIED
  PROJECT_CLAIMED
  FULLY_VERIFIED
}

// Слайс D: способы доказать контроль над монетой.
enum ClaimMethod {
  OWNER_SIGNATURE // подпись ключом адреса-владельца контракта
  DNS_TXT // TXT-запись на домене сайта
  WELL_KNOWN // файл на домене сайта
}

enum ClaimStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  CANCELLED
}

enum ProvenanceKind {
  SELF_REPORTED
  VERIFIED_ONCHAIN
  AGGREGATED
  ADMIN_SET
}

enum CoinCardVote {
  APPROVE
  REJECT
}

enum CoinCardRevisionKind {
  CONTENT
  POLICY
}

enum CoinCardRevisionStatus {
  DRAFT
  PENDING_SIGNERS
  PENDING_ADMIN
  APPLIED
  REJECTED
  EXPIRED
  WITHDRAWN
}

model Watchlist {
  userId  String
  coinId  String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin    Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)

