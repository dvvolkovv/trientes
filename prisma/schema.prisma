enum FintechService {
  CARD
  IBAN
  SEPA
  SWIFT
  SAVINGS
  CRYPTO_LOANS
  STAKING
  EXCHANGE
  CUSTODY
  PAYMENTS
  ONRAMP
  OFFRAMP
