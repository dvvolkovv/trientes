generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                       String                    @id @default(cuid())
  email                    String?                   @unique
  name                     String?
  image                    String?
  username                 String?                   @unique
  passwordHash             String?
  firstName                String?
  lastName                 String?
  phone                    String?
  role                     Role                      @default(USER)
  preferredLocale          String                    @default("en")
  preferredCurrency        String                    @default("USD")
  preferredTheme           String                    @default("system")
  emailVerified            DateTime?
  createdAt                DateTime                  @default(now())
  accounts                 Account[]
  sessions                 Session[]
  watchlist                Watchlist[]
  exchangeWatchlist        ExchangeWatchlist[]
  coinRequests             CoinRequest[]
  adminAddedCoins          Coin[]                    @relation("AdminCoinAdditions")
  reviewedRequests         CoinRequest[]             @relation("RequestReviewer")
  auditLogs                AdminAuditLog[]           @relation("AdminAuditActor")
  companies                Company[]
  registeredExchanges      RegisteredExchange[]
  reviewedPoints           CompanyPoint[]            @relation("PointReviewer")
  reviewedCompanies        Company[]                 @relation("CompanyReviewer")
  loginAttempts            LoginAttempt[]
  ownedFintechs            FintechCompany[]          @relation("FintechOwner")
  reviewedFintechs         FintechCompany[]          @relation("FintechReviewer")
  priceAlerts              PriceAlert[]
  geoAlerts                GeoAlert[]
  companyMemberships       CompanyMember[]
  companyInvitesCreated    CompanyInvite[]           @relation("CompanyInviteCreator")
  companyInvitesAccepted   CompanyInvite[]           @relation("CompanyInviteAcceptor")
  pushSubscriptions        PushSubscription[]
  notifyTelegram           Boolean                   @default(true)
  notifyEmail              Boolean                   @default(false)
  notifyWebPush            Boolean                   @default(false)
  coinCardsStewarded       CoinCard[]                @relation("CoinCardSteward")
  coinCardsReviewed        CoinCard[]                @relation("CoinCardReviewer")
  coinCardMemberships      CoinCardMember[]          @relation("CoinCardMemberUser")
  coinCardInvitesMade      CoinCardInvite[]          @relation("CoinCardInviteCreator")
  coinCardInvitesGot       CoinCardInvite[]          @relation("CoinCardInviteAcceptor")
  coinCardRevisions        CoinCardRevision[]        @relation("CoinCardRevisionAuthor")
  companyDeletionRequests  CompanyDeletionRequest[]  @relation("CompanyDeletionRequester")
  companyDeletionApprovals CompanyDeletionApproval[] @relation("CompanyDeletionVoter")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  @@index([userId])
}

enum CompanyRole {
  OWNER
  EDITOR
  VIEWER
}

model PageView {
  id        String   @id @default(cuid())
  path      String // canonical path including locale, e.g. "/en/coin/bitcoin"
  locale    String? // extracted from path for fast aggregation
  sessionId String? // anonymous 30-day rolling cookie (UUID); null for prerendered bot hits
  userId    String? // populated when the viewer is signed in
  referrer  String? // document.referrer at hit time; null for direct
  country   String? // ISO-2 from CF-IPCountry header when present
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([sessionId, createdAt])
  @@index([country, createdAt])
}

enum KybStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model CompanyMember {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CompanyRole @default(VIEWER)
  invitedById String?
  createdAt   DateTime    @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

// Shareable invite link. Created by an OWNER when the person being invited has
// no Trientes account yet (inviteMember() can only add users that already
// exist). Single-use, expires after INVITE_TTL_DAYS, revocable.
model CompanyInvite {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role         CompanyRole @default(VIEWER)
  token        String      @unique
  createdById  String
  createdBy    User        @relation("CompanyInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  acceptedById String?
  acceptedBy   User?       @relation("CompanyInviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([companyId, createdAt])
}

enum AlertOp {
  GTE
  LTE
}

model PriceAlert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  coinId    String // CoinGecko id (e.g. "bitcoin")
  symbol    String // denormalized for fast display in cabinet + notification
  op        AlertOp
  threshold Float // USD

  enabled     Boolean   @default(true)
  triggered   Boolean   @default(false) // re-arms with 3% hysteresis
  lastFiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
  @@index([enabled, coinId])
}

model GeoAlert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  countryCode String // ISO-3166-1 alpha-2

  enabled       Boolean @default(true)
  notifyFintech Boolean @default(true)
  notifyPoints  Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([userId, countryCode])
  @@index([countryCode, enabled])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum CoinSource {
  AUTO_L1
  ADMIN_ADDED
}

model Coin {
  id                    String         @id // CoinGecko id, e.g. "bitcoin"
  symbol                String
  name                  String
  slug                  String         @unique
  rank                  Int
  logoUrl               String?
  source                CoinSource     @default(AUTO_L1)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  description           String?        @db.Text
  websiteUrl            String?
  explorerUrl           String?
  whitepaperUrl         String?
  githubUrl             String?
  twitterUrl            String?
  redditUrl             String?
  metadataFetchedAt     DateTime?
  addedByAdminId        String?
  approvedFromRequestId String?        @unique
  addedBy               User?          @relation("AdminCoinAdditions", fields: [addedByAdminId], references: [id])
  approvedFromRequest   CoinRequest?   @relation("CoinRequestApproved", fields: [approvedFromRequestId], references: [id])
  snapshots             CoinSnapshot[]
  watchedBy             Watchlist[]
  card                  CoinCard?      @relation("CoinCardCoin")
}

model CoinSnapshot {
  id                String   @id @default(cuid())
  coinId            String
  coin              Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)
  priceUsd          Decimal  @db.Decimal(24, 10)
  marketCapUsd      Decimal  @db.Decimal(30, 2)
  volume24hUsd      Decimal  @db.Decimal(30, 2)
  pctChange1h       Float?
  pctChange24h      Float?
  pctChange7d       Float?
  circulatingSupply Decimal? @db.Decimal(30, 2)
  totalSupply       Decimal? @db.Decimal(30, 2)
  maxSupply         Decimal? @db.Decimal(30, 2)
  sparkline7d       Json?
  fetchedAt         DateTime @default(now())

  @@index([coinId, fetchedAt])
}

model GlobalStats {
  id                Int      @id @default(1)
  totalMarketCapUsd Decimal  @db.Decimal(30, 2)
  total24hVolumeUsd Decimal  @db.Decimal(30, 2)
  btcDominancePct   Float
  ethDominancePct   Float
  activeCryptos     Int
  markets           Int
  fetchedAt         DateTime @default(now())
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CoinCardSection {
  IDENTITY
  CONTRACTS
  TOKENOMICS
  MARKETS
  SECURITY
  TEAM
  LINKS
  MARKETING
  ACCEPTANCE
  PAYMENTS
  LEGAL
}

enum CoinCardRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CoinCardTrust {
  UNVERIFIED
  CONTRACT_VERIFIED
  PROJECT_CLAIMED
  FULLY_VERIFIED
}

enum ProvenanceKind {
  SELF_REPORTED
  VERIFIED_ONCHAIN
  AGGREGATED
  ADMIN_SET
}

enum CoinCardVote {
  APPROVE
  REJECT
}

enum CoinCardRevisionKind {
  CONTENT
  POLICY
}

enum CoinCardRevisionStatus {
  DRAFT
  PENDING_SIGNERS
  PENDING_ADMIN
  APPLIED
  REJECTED
  EXPIRED
  WITHDRAWN
}

model Watchlist {
  userId  String
  coinId  String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coin    Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)

  @@id([userId, coinId])
  @@index([userId])
}

model CoinRequest {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol       String
  name         String
  coingeckoId  String?
  reason       String        @db.Text
  status       RequestStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewedById String?
  rejectReason String?
  createdAt    DateTime      @default(now())
  reviewer     User?         @relation("RequestReviewer", fields: [reviewedById], references: [id])
  approvedCoin Coin?         @relation("CoinRequestApproved")

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum AdminAction {
  APPROVE_REQUEST
  REJECT_REQUEST
  ADD_COIN
  TOGGLE_COIN_ACTIVE
  SET_USER_ROLE
  APPROVE_POINT
  REJECT_POINT
  APPROVE_EXCHANGE
  REJECT_EXCHANGE
  APPROVE_COMPANY
  REJECT_COMPANY
  APPROVE_FINTECH
  REJECT_FINTECH
  EDIT_FINTECH
  CREATE_FINTECH
  DELETE_FINTECH
  APPROVE_COIN_CARD
  REJECT_COIN_CARD
  APPLY_COIN_REVISION
  REJECT_COIN_REVISION
  FORCE_COIN_REVISION
  DISABLE_COIN_MULTISIG
  TRANSFER_COIN_CARD
  DELETE_COMPANY
  DELETE_POINT
  RESTORE_COMPANY
  RESTORE_POINT
}

model AdminAuditLog {
  id         String      @id @default(cuid())
  actorId    String
  actor      User        @relation("AdminAuditActor", fields: [actorId], references: [id])
  action     AdminAction
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Exchange {
  id                  String              @id // CoinGecko id, e.g. "binance"
  name                String
  logoUrl             String?
  country             String?
  yearEstablished     Int?
  trustScore          Int?
  trustScoreRank      Int?
  volume24hBtc        Float
  volume24hUsd        Float
  url                 String?
  hasTradingIncentive Boolean             @default(false)
  description         String?             @db.Text
  exchangeType        String? // "CEX" | "DEX" | "HYBRID" | "OTHER"
  currencies          Int?
  pairsCount          Int?
  fiats               String[]            @default([])
  socials             Json?
  source              String              @default("cg") // "cg" | "cp" | "curated"
  makerFeePercent     Float? // standard spot maker fee, e.g. 0.10
  takerFeePercent     Float? // standard spot taker fee
  feesNote            String? // tier disclaimer ("VIP / BNB tiers reduce further")
  feesUrl             String? // link to official fee schedule
  fetchedAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  marketsFetchedAt    DateTime? // last successful per-pair sync
  watchedBy           ExchangeWatchlist[]
  markets             ExchangeMarket[]

  @@index([trustScoreRank])
  @@index([source])
}

model ExchangeMarket {
  id              String    @id // "{exchangeId}:{base}:{quote}:{category}"
  exchangeId      String
  pair            String // display label, e.g. "BTC/USDT"
  baseSymbol      String
  quoteSymbol     String
  baseCurrencyId  String? // CoinPaprika id, e.g. "btc-bitcoin"
  quoteCurrencyId String?
  category        String? // "spot" | "perpetual" | "futures" | "other"
  priceUsd        Float?
  volumeUsd24h    Float?
  volumeSharePct  Float? // adjusted_volume_share from CoinPaprika
  outlier         Boolean   @default(false)
  marketUrl       String?
  lastTradedAt    DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  exchange        Exchange  @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@index([exchangeId, volumeUsd24h(sort: Desc)])
  @@index([exchangeId, firstSeenAt(sort: Desc)])
  @@index([exchangeId, lastSeenAt])
}

model ExchangeWatchlist {
  userId     String
  exchangeId String
  addedAt    DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange   Exchange @relation(fields: [exchangeId], references: [id], onDelete: Cascade)

  @@id([userId, exchangeId])
  @@index([userId])
}

enum PointType {
  SHOP
  ATM
  POS
  SALES_OFFICE
  COMPANY
  ONLINE
}

model Company {
  id              String          @id @default(cuid())
  ownerUserId     String
  owner           User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  members         CompanyMember[]
  invites         CompanyInvite[]
  legalName       String
  displayName     String
  logoUrl         String?
  description     String?         @db.Text
  country         String?
  countryCode     String?
  city            String?
  street          String?
  houseNumber     String?
  postalCode      String?
  address         String?
  phone           String?
  email           String?
  website         String?
  socials         Json?
  status          RequestStatus   @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewer        User?           @relation("CompanyReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  points          CompanyPoint[]

  kybStatus          KybStatus @default(NONE)
  kybDocuments       Json? // [{ kind, url, label }]
  kybSubmittedAt     DateTime?
  kybReviewedAt      DateTime?
  kybRejectionReason String?

  coinCards CoinCard[]

  // Мягкое удаление: данные остаются, но объект выпадает из всех выборок.
  // Жёсткий каскад снёс бы точки, членства, приглашения и KYB-документы и
  // оставил бы висячие targetId в журнале админа.
  deletedAt   DateTime?
  deletedById String?

  deletionRequests CompanyDeletionRequest[]

  @@index([ownerUserId])
  @@index([status, createdAt])
  @@index([kybStatus])
  @@index([deletedAt])
}

model CompanyPoint {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type            PointType
  name            String
  description     String?       @db.Text
  lat             Float?
  lon             Float?
  countryCode     String?
  city            String?
  street          String?
  houseNumber     String?
  postalCode      String?
  address         String?
  acceptedCoinIds String[]
  // Собственные листинги (CoinCard.id). Параллельный массив, а не магические
  // строки "card:<id>" внутри acceptedCoinIds: те тихо сломали бы любой
  // существующий acceptedCoinIds.includes(coin.id).
  acceptedCardIds String[]
  logoUrl         String?
  photos          Json? // [{ url, label? }], max 5
  openingHours    String?
  phone           String?
  website         String?
  socials         Json?
  status          RequestStatus @default(PENDING)
  reviewedById    String?
  reviewer        User?         @relation("PointReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectReason    String?
  // Мягкое удаление, как у компании.
  deletedAt       DateTime?
  deletedById     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([companyId])
  @@index([lat, lon])
  @@index([acceptedCardIds(ops: ArrayOps)], type: Gin)
  @@index([deletedAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  ip         String
  identifier String
  success    Boolean
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([ip, createdAt])
  @@index([identifier, createdAt])
}

enum ExchangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// User-submitted exchange registrations awaiting admin moderation.
// NOTE: The existing "Exchange" model is the CoinGecko catalog (public exchange data).
// This model is named "RegisteredExchange" to avoid collision with that table.
model RegisteredExchange {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  legalName   String
  displayName String
  logoUrl     String?
  description String?
  website     String
  country     String
  email       String
  phone       String?
  address     String?
  socials     Json?

  status          ExchangeStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([status, createdAt])
}

enum FintechService {
  CARD
  IBAN
  SEPA
  SWIFT
  SAVINGS
  CRYPTO_LOANS
  STAKING
  EXCHANGE
  CUSTODY
  PAYMENTS
  ONRAMP
  OFFRAMP
}

enum FintechKyc {
  NONE
  BASIC
  FULL
}

model FintechCompany {
  id          String  @id @default(cuid())
  slug        String  @unique
  displayName String
  legalName   String?
  logoUrl     String?
  description String? @db.Text
  website     String
  socials     Json?
  foundedYear Int?

  countryCode String?
  city        String?
  address     String?
  hqLat       Float?
  hqLon       Float?

  services         FintechService[]
  supportedCoinIds String[]
  // Заполняется слайсом F3 (путь к фиату); в F1 только создаётся.
  supportedCardIds String[]
  supportedFiats   String[]
  availableIn      String[]

  kycLevel     FintechKyc?
  feesSummary  String?     @db.Text
  appStoreUrl  String?
  playStoreUrl String?

  source      String  @default("curated")
  // Один аккаунт может владеть несколькими сервисами — как и несколькими
  // компаниями (миграция 20261106200000_company_multi_owner). Ограничение
  // держал уникальный индекс, теперь его заменяют явные лимиты.
  ownerUserId String?
  owner       User?   @relation("FintechOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  status          RequestStatus @default(APPROVED)
  rejectionReason String?
  reviewedById    String?
  reviewer        User?         @relation("FintechReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, displayName])
  @@index([source])
  @@index([supportedCardIds(ops: ArrayOps)], type: Gin)
  @@index([ownerUserId])
}

// Local mirror of BTC Map's crypto-POI dump (itself OpenStreetMap data), synced
// nightly by the worker. Reading the viewport from here instead of querying the
// public Overpass API live keeps the navigator working while those instances are
// saturated. `tags` holds the untouched OSM tag map, so the same
// parseOverpassElements() turns a row back into a Poi — including the per-coin
// `coinSpecific` flag, which can only be decided at read time.
model OsmCryptoPoi {
  id       String   @id // BTC Map id, e.g. "node:9778525869"
  type     String // node | way | relation
  osmId    String
  lat      Float
  lon      Float
  tags     Json
  syncedAt DateTime @default(now())

  @@index([lat, lon])
}

// ---------------------------------------------------------------------------
// Собственный листинг монет (слайс A). Карточка намеренно отвязана от
// Coin.id = CoinGecko id: у неё свой cuid и свой slug, поэтому проект можно
// залистинговать, когда его нет ни в одном внешнем фиде. Связь с Coin
// необязательная — для монет, которые у нас уже есть.
// Спека: docs/superpowers/specs/2026-11-06-coin-card-listing-design.md
// ---------------------------------------------------------------------------

model CoinCard {
  id            String        @id @default(cuid())
  slug          String        @unique
  coinId        String?       @unique
  coin          Coin?         @relation("CoinCardCoin", fields: [coinId], references: [id], onDelete: SetNull)
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Первый подавший карточку. Владеет ею как куратор, пока проект не докажет
  // права (слайс D) — тогда вытесняется. Защита от сквоттинга листингов.
  stewardUserId String?
  steward       User?         @relation("CoinCardSteward", fields: [stewardUserId], references: [id], onDelete: SetNull)
  trust         CoinCardTrust @default(UNVERIFIED)
  status        RequestStatus @default(PENDING)
  completeness  Int           @default(0)
  name          String
  symbol        String
  tagline       String?
  description   String?       @db.Text
  logoUrl       String?
  launchDate    DateTime?
  tags          String[]      @default([])
  // Язык, на котором проект ввёл прозу. Пусто → определяется один раз
  // автоматически при первом публичном рендере и сохраняется.
  sourceLocale  String?
  consensus     String?
  hashAlgo      String?
  links         Json?
  tokenomics    Json?
  teamInfo      Json?
  marketing     Json?
  security      Json?
  // Слайс F2 (платёжный профиль) и F4 (правовой статус) — поля создаются одной
  // миграцией со всем слайсом F, наполняются позже.
  payments      Json?
  legal         Json?
  // {"<путь поля>": {kind, source, at}} — откуда взято каждое значение.
  provenance    Json?
  rejectReason  String?
  reviewedById  String?
  reviewer      User?         @relation("CoinCardReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  contracts CoinCardContract[]
  markets   CoinCardMarket[]
  members   CoinCardMember[]
  invites   CoinCardInvite[]
  revisions CoinCardRevision[]
  policy    CoinCardPolicy?

  priceIndex  CoinCardPriceIndex?
  pricePoints CoinCardPricePoint[]

  @@index([status, createdAt])
  @@index([trust])
}

// Адрес контракта в конкретной сети. Без него настоящий токен не отличить от
// подделки с тем же тикером — поэтому раздел высокорисковый.
model CoinCardContract {
  id          String    @id @default(cuid())
  cardId      String
  card        CoinCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  chain       String
  address     String
  decimals    Int?
  standard    String?
  isCanonical Boolean   @default(false)
  explorerUrl String?
  verifiedAt  DateTime? // ставится слайсом B, только когда факт сошёлся с заявлением

  // Слайс B: что ответил контракт. Заявление проекта остаётся как есть —
  // расхождение показывается рядом, а не затирает введённое.
  onchainName        String?
  onchainSymbol      String?
  onchainDecimals    Int?
  onchainTotalSupply String? // десятичная строка: uint256 не влезает в Int
  onchainFlags       String[]  @default([])
  mismatches         String[]  @default([])
  checkedAt          DateTime?
  checkError         String?

  @@unique([cardId, chain, address])
  @@index([chain, address])
  @@index([checkedAt])
}

// Где монета торгуется. claimedAt — заявлено проектом, confirmedAt — сверено
// нашим агрегатором (слайс C). priceUsd/volumeUsd24h в слайсе A всегда null.
model CoinCardMarket {
  id           String    @id @default(cuid())
  cardId       String
  card         CoinCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind         String // "CEX" | "DEX"
  exchangeId   String? // мягкая ссылка на Exchange.id, без FK
  exchangeName String
  pair         String
  tradeUrl     String?
  chain        String?
  poolAddress  String?
  priceUsd     Float?
  volumeUsd24h Float?
  claimedAt    DateTime  @default(now())
  confirmedAt  DateTime?
  // Слайс C: результат сверки с публичным API биржи.
  nativeSymbol String? // символ пары на бирже, как он найден в снимке тикеров
  quote        String? // нормализованная котировка: USDT, BTC, ...
  change24h    Float?
  isOutlier    Boolean   @default(false) // виден в таблице, но не в индексе
  checkedAt    DateTime?
  checkError   String?

  @@unique([cardId, kind, exchangeName, pair])
  @@index([cardId])
}

// Участник команды карточки. Образец — CompanyMember.
model CoinCardMember {
  id          String            @id @default(cuid())
  cardId      String
  card        CoinCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation("CoinCardMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role        CoinCardRole      @default(VIEWER)
  sections    CoinCardSection[] @default([]) // значимо только для EDITOR
  isSigner    Boolean           @default(false) // входит в группу мультиподписи
  invitedById String?
  createdAt   DateTime          @default(now())

  approvals CoinCardApproval[]

  @@unique([cardId, userId])
  @@index([userId])
}

// Одноразовая ссылка-приглашение для тех, у кого ещё нет аккаунта.
// Образец — CompanyInvite.
model CoinCardInvite {
  id           String            @id @default(cuid())
  cardId       String
  card         CoinCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  role         CoinCardRole      @default(VIEWER)
  sections     CoinCardSection[] @default([])
  isSigner     Boolean           @default(false)
  token        String            @unique
  createdById  String
  createdBy    User              @relation("CoinCardInviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  acceptedById String?
  acceptedBy   User?             @relation("CoinCardInviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime          @default(now())

  @@index([cardId, createdAt])
}

// Политика мультиподписи. Пустой sections = применяется ко всем изменениям.
model CoinCardPolicy {
  cardId    String            @id
  card      CoinCard          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  multisig  Boolean           @default(false)
  threshold Int               @default(1) // M из N подписантов
  sections  CoinCardSection[] @default([])
  updatedAt DateTime          @updatedAt
}

// Слайс C. Наш собственный ценовой индекс карточки: медиана цены по весу
// суточного объёма подтверждённых рынков. Отдельная модель, а не поля в
// CoinCard, потому что это вычисленное значение со своей методикой — ревизии
// и диффы карточки (coin-card-diff.ts) его не касаются.
model CoinCardPriceIndex {
  id           String   @id @default(cuid())
  cardId       String   @unique
  card         CoinCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  priceUsd     Float
  change24h    Float?
  volumeUsd24h Float
  marketCount  Int
  spreadPct    Float?
  confidence   String // HIGH | MEDIUM | LOW
  method       String   @default("VWMEDIAN_V1")
  computedAt   DateTime
}

// Часовая история индекса. График — не этот слайс, но историю нельзя добрать
// потом, поэтому точки копятся с первого прогона. Хранение — 90 дней.
model CoinCardPricePoint {
  id           String   @id @default(cuid())
  cardId       String
  card         CoinCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  priceUsd     Float
  volumeUsd24h Float
  marketCount  Int
  at           DateTime // округлено до часа

  @@unique([cardId, at])
  @@index([cardId, at])
}

// Пакет изменений. thresholdAt/signerCountAt — снимок на момент подачи: без
// него смена состава подписантов на ходу меняет исход идущего голосования.
model CoinCardRevision {
  id            String                 @id @default(cuid())
  cardId        String
  card          CoinCard               @relation(fields: [cardId], references: [id], onDelete: Cascade)
  kind          CoinCardRevisionKind   @default(CONTENT)
  section       CoinCardSection? // null только при kind = POLICY
  authorId      String
  author        User                   @relation("CoinCardRevisionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  status        CoinCardRevisionStatus @default(DRAFT)
  highRisk      Boolean                @default(false)
  diff          Json // [{path, before, after}]
  thresholdAt   Int?
  signerCountAt Int?
  expiresAt     DateTime?
  adminId       String?
  adminNote     String?
  decidedAt     DateTime?
  appliedAt     DateTime?
  createdAt     DateTime               @default(now())

  approvals CoinCardApproval[]

  @@index([cardId, createdAt])
  @@index([status, createdAt])
}

// Один подписант — один голос (@@unique). Отказ закрывает ревизию, только
// когда порог становится арифметически недостижим — права вето ни у кого нет.
model CoinCardApproval {
  id         String           @id @default(cuid())
  revisionId String
  revision   CoinCardRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  memberId   String
  member     CoinCardMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  decision   CoinCardVote
  comment    String?
  createdAt  DateTime         @default(now())

  @@unique([revisionId, memberId])
  @@index([revisionId])
}

enum CompanyDeletionKind {
  COMPANY
  POINT
}

enum CompanyDeletionStatus {
  PENDING
  APPLIED
  REJECTED
  WITHDRAWN
  EXPIRED
}

enum CompanyDeletionVote {
  APPROVE
  REJECT
}

// Узкая мультиподпись: только про удаление и только голосами владельцев.
// Конвейер ревизий карточки монеты сюда не тащим — там решается другая задача.
// thresholdAt/ownerCountAt — снимок на момент подачи: без него уход владельца
// на ходу меняет исход идущего голосования.
model CompanyDeletionRequest {
  id            String                @id @default(cuid())
  companyId     String
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          CompanyDeletionKind
  pointId       String? // только при kind = POINT
  requestedById String
  requestedBy   User                  @relation("CompanyDeletionRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reason        String?               @db.Text
  status        CompanyDeletionStatus @default(PENDING)
  thresholdAt   Int
  ownerCountAt  Int
  expiresAt     DateTime
  decidedAt     DateTime?
  createdAt     DateTime              @default(now())

  approvals CompanyDeletionApproval[]

  @@index([companyId, status])
  @@index([status, expiresAt])
  @@index([pointId])
}

model CompanyDeletionApproval {
  id        String                 @id @default(cuid())
  requestId String
  request   CompanyDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User                   @relation("CompanyDeletionVoter", fields: [userId], references: [id], onDelete: Cascade)
  vote      CompanyDeletionVote
  createdAt DateTime               @default(now())

  @@unique([requestId, userId])
}
