# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated MapLibre worker assets (created by predev/pretest/prebuild)
/public/maplibre/

# misc
.DS_Store
*.pem
/.worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/

# Playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
/.playwright-mcp/

# runtime logs
/bot/logs/
incoming/
.next-preview

# assistant work artifacts (voice reports, screenshots) — archived in
# /home/dv/trientes-artifacts/, never part of the site
/otchet-*.mp3
/*.png
/*.mp3

# user uploads (coin logos, point photos, KYB documents) — runtime data of the
# live box, never source. The two tracked .gitkeep files stay tracked:
# .gitignore does not untrack what git already knows about.
/public/uploads/
